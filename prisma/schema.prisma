// ============================================================================
// FSW People — HRIS data model
//
// Conventions
//  - cuid() primary keys
//  - Effective-dated records (EmploymentRecord, Compensation, EquipmentAssignment,
//    AppAccessGrant) are never overwritten: closing a record sets effectiveTo /
//    revokedAt and a new row is opened. See DATA_MODEL.md.
//  - Highly sensitive values (SSN, bank accounts, tax/passport/PH government
//    identifiers) are stored AES-256-GCM encrypted in dedicated tables
//    (WorkerIdentifier, BankAccount) with a plaintext last4 for display.
//  - AuditEvent is append-only; a DB trigger blocks UPDATE/DELETE (see the
//    migration in prisma/migrations).
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Organization structure
// ---------------------------------------------------------------------------

model Organization {
  id               String    @id @default(cuid())
  name             String
  branding         Json      @default("{}") // logo url, accent color overrides
  setupCompletedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  legalEntities LegalEntity[]
}

model LegalEntity {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String   @unique // e.g. FSW, VLV
  country        String   @default("US")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  employments  EmploymentRecord[]
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams       Team[]
  employments EmploymentRecord[]
}

model Team {
  id           String   @id @default(cuid())
  departmentId String
  name         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  department  Department         @relation(fields: [departmentId], references: [id])
  employments EmploymentRecord[]

  @@unique([departmentId, name])
}

model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  street    String?
  city      String?
  state     String?
  postal    String?
  country   String   @default("US")
  timezone  String   @default("America/New_York")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  employments EmploymentRecord[]
}

// ---------------------------------------------------------------------------
// Identity, access, sessions
// ---------------------------------------------------------------------------

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String?
  status             UserStatus @default(INVITED)
  mfaSecretEnc       String? // encrypted TOTP secret
  mfaEnabled         Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  worker            Worker?
  roles             UserRole[]
  sessions          Session[]
  tokens            AuthToken[]
  notifications     Notification[]
  notificationPrefs Json       @default("{}")
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  ip         String?
  userAgent  String?
  mfaPassed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Activation / password-reset / signed-download tokens
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  kind      AuthTokenKind
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

enum AuthTokenKind {
  ACTIVATION
  PASSWORD_RESET
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique // SUPER_ADMIN, HR_ADMIN, EXECUTIVE, MANAGER, EMPLOYEE, CONTRACTOR, FINANCE, RECRUITER, IT_ADMIN, AUDITOR
  name        String
  description String?
  system      Boolean  @default(false) // seeded roles cannot be deleted
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  users       UserRole[]
}

model RolePermission {
  id         String @id @default(cuid())
  roleId     String
  permission String // e.g. "people.read", "compensation.write", "pii.reveal"
  // Optional scope narrowing: { legalEntityIds?, departmentIds?, countries? }
  scope      Json   @default("{}")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// ---------------------------------------------------------------------------
// Workers (people system of record)
// ---------------------------------------------------------------------------

enum WorkerType {
  EMPLOYEE
  CONTRACTOR
  EOR // employed via employer-of-record / third party
  AGENCY
}

enum WorkerStatus {
  PRE_START
  ONBOARDING
  ACTIVE
  ON_LEAVE
  OFFBOARDING
  TERMINATED
}

model Worker {
  id              String       @id @default(cuid())
  employeeNumber  String       @unique // e.g. FSW-0001
  userId          String?      @unique
  // Identity
  legalFirstName  String
  preferredName   String?
  middleName      String?
  lastName        String
  suffix          String?
  pronouns        String?
  photoUrl        String?
  workEmail       String?      @unique
  personalEmail   String? // restricted visibility
  phone           String?
  dateOfBirth     DateTime? // restricted visibility (pii.view)
  // Celebration display is opt-out and shows month/day only — never the year,
  // and never the dateOfBirth value itself. See §51 privacy-by-design.
  showBirthday    Boolean      @default(true)
  homeStreet      String? // restricted visibility
  homeCity        String?
  homeState       String?
  homePostal      String?
  homeCountry     String?
  // Classification — explicitly HR-controlled, never auto-derived
  workerType      WorkerType
  status          WorkerStatus @default(PRE_START)
  country         String       @default("US")
  citizenship     String?
  timezone        String       @default("America/New_York")
  localCurrency   String       @default("USD")
  engagementModel String? // e.g. "DIRECT", "EOR", "STAFF_AUGMENTATION"
  // Dates
  hireDate        DateTime?
  originalHireDate DateTime?
  seniorityDate   DateTime?
  terminationDate DateTime?
  terminationReason String?
  voluntaryTermination Boolean?
  rehireEligible  Boolean?
  isDemo          Boolean      @default(false)
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user               User?               @relation(fields: [userId], references: [id])
  employments        EmploymentRecord[]
  compensations      Compensation[]
  emergencyContacts  EmergencyContact[]
  identifiers        WorkerIdentifier[]
  bankAccounts       BankAccount[]
  contractorProfile  ContractorProfile?
  timeline           TimelineEvent[]
  tasksAbout         Task[]              @relation("TaskAboutWorker")
  documents          Document[]
  ptoAssignments     PtoPolicyAssignment[]
  ptoTransactions    PtoTransaction[]
  ptoRequests        PtoRequest[]
  timesheets         Timesheet[]
  goals              Goal[]
  reviewsAbout       PerformanceReview[] @relation("ReviewSubject")
  reviewsWritten     PerformanceReview[] @relation("ReviewAuthor")
  oneOnOnesAsManager OneOnOne[]          @relation("OooManager")
  oneOnOnesAsReport  OneOnOne[]          @relation("OooReport")
  feedbackAbout      Feedback[]          @relation("FeedbackAbout")
  feedbackWritten    Feedback[]          @relation("FeedbackAuthor")
  hrCases            HrCase[]
  benefitEnrollments BenefitEnrollment[]
  equipmentAssignments EquipmentAssignment[]
  appAccessGrants    AppAccessGrant[]
  trainingAssignments TrainingAssignment[]
  lifecycleInstances LifecycleInstance[]
  policyAcks         PolicyAcknowledgment[]
  contractorPayments ContractorPayment[]
  customFieldValues  CustomFieldValue[]
  managedEmployments EmploymentRecord[]  @relation("ManagerOf")
  dottedEmployments  EmploymentRecord[]  @relation("SecondaryManagerOf")
  complianceItems    ComplianceItem[]
  signatures         DocumentSignature[]
  announcementAcks   AnnouncementAck[]

  @@index([status, workerType])
  @@index([lastName, legalFirstName])
  skills           WorkerSkill[]
  compProposals    CompProposal[]
  referralsMade    Referral[]        @relation("ReferralsMade")
  shiftAssignments ShiftAssignment[]
}

// Effective-dated employment. The "current" record has effectiveTo = null.
model EmploymentRecord {
  id                 String    @id @default(cuid())
  workerId           String
  legalEntityId      String
  departmentId       String?
  teamId             String?
  locationId         String?
  managerId          String?
  secondaryManagerId String?
  title              String
  jobFamily          String?
  jobLevel           String?
  employmentBasis    String? // FULL_TIME | PART_TIME
  flsaStatus         String? // EXEMPT | NON_EXEMPT (US employees)
  payBasis           String? // SALARY | HOURLY
  workMode           String? // REMOTE | HYBRID | ONSITE
  workState          String? // e.g. PA — drives state onboarding rules
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  changeReason       String? // HIRE | PROMOTION | TRANSFER | MANAGER_CHANGE | ...
  createdAt          DateTime  @default(now())

  worker           Worker      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  legalEntity      LegalEntity @relation(fields: [legalEntityId], references: [id])
  department       Department? @relation(fields: [departmentId], references: [id])
  team             Team?       @relation(fields: [teamId], references: [id])
  location         Location?   @relation(fields: [locationId], references: [id])
  manager          Worker?     @relation("ManagerOf", fields: [managerId], references: [id])
  secondaryManager Worker?     @relation("SecondaryManagerOf", fields: [secondaryManagerId], references: [id])

  @@index([workerId, effectiveFrom])
  @@index([managerId])
}

// Effective-dated compensation history. Never overwritten.
model Compensation {
  id            String    @id @default(cuid())
  workerId      String
  amount        Decimal   @db.Decimal(14, 2)
  currency      String    @default("USD")
  rateType      String // ANNUAL | HOURLY | MONTHLY | DAILY
  payFrequency  String? // BIWEEKLY | SEMIMONTHLY | MONTHLY | ...
  bonusTargetPct Decimal? @db.Decimal(5, 2)
  commissionPlan String?
  allowances    Json      @default("[]") // [{name, amount, currency, cadence}]
  reason        String // HIRE | MERIT | PROMOTION | MARKET | CONTRACT_RATE | ...
  note          String?
  effectiveFrom DateTime
  effectiveTo   DateTime?
  approvedById  String?
  createdAt     DateTime  @default(now())

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, effectiveFrom])
}

model EmergencyContact {
  id           String  @id @default(cuid())
  workerId     String
  name         String
  relationship String?
  phone        String
  email        String?
  isPrimary    Boolean @default(true)

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

// Encrypted government / tax identifiers. valueEnc = AES-256-GCM envelope.
model WorkerIdentifier {
  id        String   @id @default(cuid())
  workerId  String
  kind      String // SSN | EIN | ITIN | PH_TIN | PH_SSS | PH_PHILHEALTH | PH_PAGIBIG | PASSPORT | OTHER
  label     String?
  valueEnc  String
  last4     String?
  country   String?
  expiresAt DateTime? // e.g. passport / work authorization expiry
  createdAt DateTime @default(now())
  createdById String?

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, kind, label])
}

model BankAccount {
  id             String   @id @default(cuid())
  workerId       String
  nickname       String?
  bankName       String?
  accountType    String? // CHECKING | SAVINGS
  routingEnc     String?
  accountEnc     String
  accountLast4   String
  currency       String   @default("USD")
  country        String   @default("US")
  depositPercent Decimal? @db.Decimal(5, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

model ContractorProfile {
  id             String    @id @default(cuid())
  workerId       String    @unique
  isBusiness     Boolean   @default(false)
  businessName   String?
  dba            String?
  contractStart  DateTime?
  contractEnd    DateTime?
  paymentTerms   String? // NET_15 | NET_30 | ...
  paymentMethod  String? // ACH | WISE | PAYONEER | CHECK | ...
  internalOwnerId String?
  w9Status       String? // NOT_REQUIRED | REQUESTED | RECEIVED
  w8Status       String? // for foreign persons: NOT_REQUIRED | REQUESTED | RECEIVED (W-8BEN / W-8BEN-E)
  is1099Eligible Boolean?
  notes          String?

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

model ContractorPayment {
  id         String   @id @default(cuid())
  workerId   String
  invoiceRef String?
  amount     Decimal  @db.Decimal(14, 2)
  currency   String   @default("USD")
  periodStart DateTime?
  periodEnd  DateTime?
  paidAt     DateTime?
  status     String   @default("RECORDED") // RECORDED | APPROVED | PAID
  note       String?
  createdAt  DateTime @default(now())

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

model TimelineEvent {
  id        String   @id @default(cuid())
  workerId  String
  kind      String // HIRE | TITLE_CHANGE | MANAGER_CHANGE | COMP_CHANGE | REVIEW | WARNING | LEAVE | TRAINING | EQUIPMENT | POLICY_ACK | OFFBOARDING | TERMINATION | REHIRE | NOTE | ...
  title     String
  detail    String?
  // Minimum permission needed to see this event:
  visibility String  @default("MANAGER") // SELF | MANAGER | HR | COMP | HR_CONFIDENTIAL
  occurredAt DateTime @default(now())
  actorUserId String?
  createdAt DateTime @default(now())

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, occurredAt])
}

// Data-driven "which documents does this population owe" configuration (§14).
model RequiredDocumentRule {
  id           String  @id @default(cuid())
  name         String
  documentKind String // maps to DocumentCategory or a named form e.g. "W4", "W8BEN"
  country      String? // null = any
  workerType   WorkerType?
  workState    String?
  legalEntityId String?
  note         String? // e.g. "Verify with HR/legal/payroll provider"
  active       Boolean @default(true)
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Recruiting (ATS)
// ---------------------------------------------------------------------------

enum RequisitionStatus {
  DRAFT
  PENDING_APPROVAL
  OPEN
  ON_HOLD
  FILLED
  CLOSED
}

model JobRequisition {
  id              String            @id @default(cuid())
  title           String
  departmentId    String?
  legalEntityId   String?
  hiringManagerId String?
  recruiterId     String?
  locationText    String?
  employmentType  String? // FULL_TIME | PART_TIME | CONTRACT
  workerType      WorkerType        @default(EMPLOYEE)
  headcount       Int               @default(1)
  isReplacement   Boolean           @default(false)
  salaryMin       Decimal?          @db.Decimal(14, 2)
  salaryMax       Decimal?          @db.Decimal(14, 2)
  currency        String            @default("USD")
  description     String?
  requirements    String?
  status          RequisitionStatus @default(DRAFT)
  targetDate      DateTime?
  openedAt        DateTime?
  closedAt        DateTime?
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  applications Application[]
  offers       Offer[]
  boardPostings JobBoardPosting[]
  skillRequirements JobSkillRequirement[]
}

model Candidate {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String?
  phone        String?
  source       String? // REFERRAL | LINKEDIN | INDEED | WEBSITE | AGENCY | OTHER
  referredBy   String?
  linkedinUrl  String?
  resumeDocId  String?
  // Plain-text resume/experience. Populated from an Indeed Apply structured
  // resume, or pasted by a recruiter when the CV is a PDF we cannot parse.
  // This is what the AI interview-question generator reads.
  resumeText   String?
  notes        String?
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications Application[]
  referrals    Referral[]
  talentPool   TalentPoolEntry?
}

model PipelineStage {
  id        String  @id @default(cuid())
  name      String  @unique
  order     Int
  isTerminal Boolean @default(false)

  applications Application[]
}

model Application {
  id             String   @id @default(cuid())
  candidateId    String
  requisitionId  String
  stageId        String
  status         String   @default("ACTIVE") // ACTIVE | REJECTED | WITHDRAWN | HIRED
  rejectionReason String?
  aiSummary      String? // AI-assisted summary — advisory only, never auto-rejects
  // Set when the application arrived from a job board (e.g. Indeed Apply).
  // Unique so a webhook redelivery can never create a duplicate application.
  sourceBoard    String? // INDEED | ...
  sourceRef      String? @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  questionSets InterviewQuestionSet[]
  candidate   Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  requisition JobRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  stage       PipelineStage  @relation(fields: [stageId], references: [id])
  interviews  Interview[]
  offers      Offer[]

  @@unique([candidateId, requisitionId])
}

model Interview {
  id            String   @id @default(cuid())
  applicationId String
  kind          String // PHONE_SCREEN | HIRING_MANAGER | PANEL | TECHNICAL | FINAL | REFERENCE
  scheduledAt   DateTime?
  durationMin   Int?
  interviewerIds Json    @default("[]") // user ids
  status        String   @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELED
  createdAt     DateTime @default(now())

  application Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scorecards  InterviewScorecard[]
}

model InterviewScorecard {
  id             String   @id @default(cuid())
  interviewId    String
  interviewerUserId String
  rating         Int? // 1-5
  recommendation String? // STRONG_YES | YES | NO | STRONG_NO
  notes          String?
  submittedAt    DateTime?
  createdAt      DateTime @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([interviewId, interviewerUserId])
}

model Offer {
  id            String    @id @default(cuid())
  applicationId String
  requisitionId String
  title         String
  legalEntityId String?
  startDate     DateTime?
  amount        Decimal   @db.Decimal(14, 2)
  currency      String    @default("USD")
  rateType      String    @default("ANNUAL")
  bonusTargetPct Decimal? @db.Decimal(5, 2)
  commissionPlan String?
  contingencies String?
  expiresAt     DateTime?
  status        String    @default("DRAFT") // DRAFT | PENDING_APPROVAL | SENT | ACCEPTED | DECLINED | EXPIRED | WITHDRAWN
  sentAt        DateTime?
  respondedAt   DateTime?
  hiredWorkerId String?
  approvalRequestId String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  application Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requisition JobRequisition @relation(fields: [requisitionId], references: [id])
}

// ---------------------------------------------------------------------------
// Job boards (Indeed)
// ---------------------------------------------------------------------------

/**
 * A requisition published to an external job board. FSW People publishes to
 * Indeed by hosting an XML feed that Indeed crawls on its own schedule, so
 * "published" here means "included in the feed", not "confirmed live" —
 * Indeed decides when it indexes and whether it accepts a posting.
 */
model JobBoardPosting {
  id            String    @id @default(cuid())
  requisitionId String
  board         String    @default("INDEED")
  status        String    @default("PUBLISHED") // PUBLISHED | REMOVED
  // Indeed reads these from the feed; they can differ from the internal record
  // (e.g. a public location string, or salary hidden from the ad).
  publicTitle   String?
  publicLocation String?
  showSalary    Boolean   @default(false)
  remoteType    String? // ONSITE | HYBRID | REMOTE
  publishedById String?
  publishedAt   DateTime  @default(now())
  removedAt     DateTime?
  // Set when the feed is next generated, so admins can see Indeed has crawled.
  lastFeedAt    DateTime?

  requisition JobRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@unique([requisitionId, board])
  @@index([board, status])
}

/**
 * Append-only log of every inbound job-board delivery, including rejected
 * ones. Kept separate from Application so a malformed or unauthenticated
 * payload is still visible to whoever debugs the integration.
 */
model JobBoardDelivery {
  id            String   @id @default(cuid())
  board         String   @default("INDEED")
  externalId    String?
  status        String // ACCEPTED | DUPLICATE | REJECTED | ERROR
  detail        String?
  requisitionId String?
  applicationId String?
  // Raw payload with contact details removed — enough to debug a mapping
  // problem without keeping a second copy of candidate PII.
  payloadDigest Json?
  receivedAt    DateTime @default(now())

  @@index([board, receivedAt])
  @@index([externalId])
}

// ---------------------------------------------------------------------------
// AI-assisted recruiting (§16 — advisory only, never autonomous)
// ---------------------------------------------------------------------------

/**
 * A generated set of interview questions for one application.
 *
 * Advisory output: an interviewer chooses what to ask. Nothing here feeds a
 * score, a stage change or a rejection, and every generation is audited with
 * the model and the inputs used.
 */
model InterviewQuestionSet {
  id            String   @id @default(cuid())
  applicationId String
  // [{ question, rationale, listenFor, basis }]
  questions     Json     @default("[]")
  model         String
  // Which inputs the model actually saw, so a reader knows how grounded the
  // questions are (e.g. whether a resume was available at all).
  basis         Json     @default("{}")
  generatedById String
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

// ---------------------------------------------------------------------------
// Onboarding / Offboarding / Tasks
// ---------------------------------------------------------------------------

enum LifecycleKind {
  ONBOARDING
  OFFBOARDING
}

model LifecycleTemplate {
  id        String        @id @default(cuid())
  kind      LifecycleKind
  name      String
  description String?
  active    Boolean       @default(true)
  isDefault Boolean       @default(false)
  // Which populations this template applies to (all conditions optional):
  // { countries?: string[], workerTypes?: string[], departmentIds?: string[], workStates?: string[], workModes?: string[] }
  conditions Json         @default("{}")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  items     LifecycleTemplateItem[]
  instances LifecycleInstance[]
}

model LifecycleTemplateItem {
  id          String  @id @default(cuid())
  templateId  String
  title       String
  description String?
  category    TaskCategory @default(ONBOARDING)
  ownerKind   String // EMPLOYEE | MANAGER | HR | IT | FINANCE | CUSTOM_USER
  ownerUserId String? // when CUSTOM_USER
  dueOffsetDays Int   @default(0) // relative to start date (negative = before)
  order       Int     @default(0)
  dependsOnOrder Int? // simple ordering dependency
  // Additional row-level conditions, same shape as template conditions
  conditions  Json    @default("{}")

  template LifecycleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model LifecycleInstance {
  id         String        @id @default(cuid())
  workerId   String
  templateId String?
  kind       LifecycleKind
  status     String        @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | CANCELED
  startDate  DateTime // hire date or last day
  reason     String? // offboarding: RESIGNATION | TERMINATION | RETIREMENT | CONTRACT_END | LAYOFF | OTHER
  voluntary  Boolean?
  completedAt DateTime?
  createdById String?
  createdAt  DateTime      @default(now())

  worker   Worker             @relation(fields: [workerId], references: [id], onDelete: Cascade)
  template LifecycleTemplate? @relation(fields: [templateId], references: [id])
  tasks    Task[]
}

enum TaskCategory {
  ONBOARDING
  OFFBOARDING
  COMPLIANCE
  IT_ACCESS
  EQUIPMENT
  TRAINING
  DOCUMENT
  RECRUITING
  HR
  GENERAL
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELED
}

model Task {
  id            String       @id @default(cuid())
  title         String
  description   String?
  category      TaskCategory @default(GENERAL)
  status        TaskStatus   @default(OPEN)
  priority      String       @default("NORMAL") // LOW | NORMAL | HIGH | CRITICAL
  workerId      String? // the worker this task is about
  ownerUserId   String? // assignee (user)
  ownerRoleKey  String? // or a role queue (e.g. IT_ADMIN)
  dueDate       DateTime?
  dependsOnId   String?
  lifecycleId   String?
  sourceType    String? // WORKFLOW | TEMPLATE | MANUAL | COMPLIANCE | SYSTEM
  sourceId      String?
  completedAt   DateTime?
  completedById String?
  createdById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  worker    Worker?            @relation("TaskAboutWorker", fields: [workerId], references: [id], onDelete: Cascade)
  dependsOn Task?              @relation("TaskDependency", fields: [dependsOnId], references: [id])
  dependents Task[]            @relation("TaskDependency")
  lifecycle LifecycleInstance? @relation(fields: [lifecycleId], references: [id], onDelete: Cascade)
  comments  TaskComment[]

  @@index([ownerUserId, status])
  @@index([ownerRoleKey, status])
  @@index([workerId])
  @@index([dueDate])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorUserId String
  body      String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Documents / Policies / Signatures
// ---------------------------------------------------------------------------

enum DocumentCategory {
  OFFER
  EMPLOYMENT_AGREEMENT
  CONTRACTOR_AGREEMENT
  TAX_FORM
  I9
  HANDBOOK
  POLICY
  REVIEW
  DISCIPLINARY
  CERTIFICATION
  TRAINING
  COMPENSATION
  BENEFITS
  ID_DOCUMENT
  OTHER
}

enum DataClassification {
  PUBLIC_INTERNAL
  INTERNAL
  CONFIDENTIAL
  HIGHLY_RESTRICTED
}

model Document {
  id             String             @id @default(cuid())
  title          String
  category       DocumentCategory   @default(OTHER)
  classification DataClassification @default(CONFIDENTIAL)
  workerId       String?
  legalEntityId  String?
  tags           Json               @default("[]")
  expiresAt      DateTime?
  retentionDate  DateTime? // earliest permitted destruction date (computed from RetentionPolicy)
  requiresSignature Boolean         @default(false)
  uploadedById   String?
  deletedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  worker   Worker?           @relation(fields: [workerId], references: [id])
  versions DocumentVersion[]

  @@index([workerId, category])
  @@index([expiresAt])
}

model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  version    Int
  fileKey    String // storage key
  fileName   String
  mimeType   String
  sizeBytes  Int
  sha256     String?
  uploadedById String?
  effectiveAt DateTime?
  approvedBy String? // who approved this template/form version (legal docs)
  createdAt  DateTime @default(now())

  document   Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signatures DocumentSignature[]

  @@unique([documentId, version])
}

// Immutable signature/acknowledgment event — always tied to a specific version.
model DocumentSignature {
  id                String   @id @default(cuid())
  documentVersionId String
  workerId          String
  userId            String?
  kind              String   @default("ACKNOWLEDGMENT") // ACKNOWLEDGMENT | SIGNATURE
  signedName        String?
  ip                String?
  userAgent         String?
  signedAt          DateTime @default(now())

  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id])
  worker          Worker          @relation(fields: [workerId], references: [id])

  @@unique([documentVersionId, workerId, kind])
}

model Policy {
  id          String   @id @default(cuid())
  title       String
  category    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions PolicyVersion[]
}

model PolicyVersion {
  id           String    @id @default(cuid())
  policyId     String
  version      Int
  bodyHtml     String? // inline policy text
  documentId   String? // or an uploaded file
  effectiveAt  DateTime  @default(now())
  requiresAck  Boolean   @default(true)
  ackDeadlineDays Int?
  // Targeting: { legalEntityIds?, departmentIds?, countries?, workerTypes? }
  audience     Json      @default("{}")
  publishedAt  DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())

  policy Policy                @relation(fields: [policyId], references: [id], onDelete: Cascade)
  acks   PolicyAcknowledgment[]

  @@unique([policyId, version])
}

model PolicyAcknowledgment {
  id              String   @id @default(cuid())
  policyVersionId String
  workerId        String
  viewedAt        DateTime?
  acknowledgedAt  DateTime?
  ip              String?

  policyVersion PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)
  worker        Worker        @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([policyVersionId, workerId])
}

// ---------------------------------------------------------------------------
// PTO / Holidays / Time
// ---------------------------------------------------------------------------

model PtoPolicy {
  id            String   @id @default(cuid())
  name          String
  leaveType     String // VACATION | SICK | PERSONAL | FLOATING | BEREAVEMENT | PARENTAL | JURY | UNPAID | CUSTOM
  country       String? // policy applies to
  accrualMethod String   @default("ANNUAL_GRANT") // NONE | ANNUAL_GRANT | MONTHLY | PER_PAY_PERIOD | FRONTLOAD
  hoursPerYear  Decimal  @db.Decimal(7, 2) @default(0)
  carryoverCapHours Decimal? @db.Decimal(7, 2)
  maxBalanceHours   Decimal? @db.Decimal(7, 2)
  waitingPeriodDays Int    @default(0)
  allowNegative Boolean  @default(false)
  requiresApproval Boolean @default(true)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  assignments  PtoPolicyAssignment[]
  transactions PtoTransaction[]
  requests     PtoRequest[]
}

model PtoPolicyAssignment {
  id        String   @id @default(cuid())
  workerId  String
  policyId  String
  startDate DateTime @default(now())
  endDate   DateTime?

  worker Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  policy PtoPolicy @relation(fields: [policyId], references: [id])

  @@unique([workerId, policyId, startDate])
}

// Balance = SUM(hours) over transactions. Signed: accruals +, usage -.
model PtoTransaction {
  id            String   @id @default(cuid())
  workerId      String
  policyId      String
  kind          String // ACCRUAL | GRANT | USAGE | ADJUSTMENT | CARRYOVER | EXPIRY
  hours         Decimal  @db.Decimal(7, 2)
  effectiveDate DateTime
  note          String?
  requestId     String?
  createdById   String?
  createdAt     DateTime @default(now())

  worker  Worker      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  policy  PtoPolicy   @relation(fields: [policyId], references: [id])
  request PtoRequest? @relation(fields: [requestId], references: [id])

  @@index([workerId, policyId])
}

model PtoRequest {
  id         String   @id @default(cuid())
  workerId   String
  policyId   String
  startDate  DateTime
  endDate    DateTime
  hours      Decimal  @db.Decimal(7, 2)
  note       String?
  status     String   @default("PENDING") // PENDING | APPROVED | DENIED | CANCELED
  approverId String? // user id
  decidedAt  DateTime?
  decisionNote String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  worker       Worker           @relation(fields: [workerId], references: [id], onDelete: Cascade)
  policy       PtoPolicy        @relation(fields: [policyId], references: [id])
  transactions PtoTransaction[]

  @@index([status])
  @@index([workerId])
}

model HolidayCalendar {
  id      String  @id @default(cuid())
  name    String  @unique
  country String
  active  Boolean @default(true)

  holidays Holiday[]
}

model Holiday {
  id           String   @id @default(cuid())
  calendarId   String
  name         String
  date         DateTime
  observedDate DateTime?
  kind         String   @default("PAID") // PAID | UNPAID | FLOATING

  calendar HolidayCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, date, name])
}

model Timesheet {
  id         String   @id @default(cuid())
  workerId   String
  weekStart  DateTime // Monday
  status     String   @default("OPEN") // OPEN | SUBMITTED | APPROVED | REJECTED
  submittedAt DateTime?
  approvedById String?
  approvedAt DateTime?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  worker  Worker      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  entries TimeEntry[]

  @@unique([workerId, weekStart])
}

model TimeEntry {
  id           String    @id @default(cuid())
  timesheetId  String
  date         DateTime
  clockIn      DateTime?
  clockOut     DateTime?
  breakMinutes Int       @default(0)
  manualHours  Decimal?  @db.Decimal(5, 2) // for manual timesheets
  projectCode  String?
  note         String?
  editedById   String? // audit: who corrected it
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  timesheet Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Performance / Talent
// ---------------------------------------------------------------------------

model ReviewCycle {
  id        String   @id @default(cuid())
  name      String
  kind      String // ANNUAL | SEMIANNUAL | QUARTERLY | DAY_30 | DAY_60 | DAY_90 | PROBATION | PROMOTION | AD_HOC
  startDate DateTime
  dueDate   DateTime
  status    String   @default("OPEN") // DRAFT | OPEN | CALIBRATION | CLOSED
  questions Json     @default("[]") // [{id, text, type: RATING|SCALE|TEXT|CHOICE, options?, forms: ["SELF","MANAGER"]}]
  createdAt DateTime @default(now())

  reviews PerformanceReview[]
}

model PerformanceReview {
  id             String    @id @default(cuid())
  cycleId        String?
  subjectId      String
  authorId       String
  form           String // SELF | MANAGER | PEER | UPWARD
  status         String    @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | SUBMITTED | SHARED
  answers        Json      @default("{}") // {questionId: value}
  overallRating  Int?
  summary        String?
  submittedAt    DateTime?
  sharedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  cycle   ReviewCycle? @relation(fields: [cycleId], references: [id])
  subject Worker       @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  author  Worker       @relation("ReviewAuthor", fields: [authorId], references: [id])

  @@index([subjectId])
  @@index([authorId, status])
}

model Goal {
  id          String    @id @default(cuid())
  workerId    String? // null for department/company goals
  departmentId String?
  level       String    @default("INDIVIDUAL") // INDIVIDUAL | DEPARTMENT | COMPANY
  title       String
  description String?
  weight      Int? // percent
  dueDate     DateTime?
  progress    Int       @default(0) // 0-100
  status      String    @default("ACTIVE") // DRAFT | ACTIVE | COMPLETED | CANCELED
  parentId    String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  worker   Worker? @relation(fields: [workerId], references: [id], onDelete: Cascade)
  parent   Goal?   @relation("GoalAlignment", fields: [parentId], references: [id])
  children Goal[]  @relation("GoalAlignment")
}

model OneOnOne {
  id               String    @id @default(cuid())
  managerId        String
  reportId         String
  scheduledAt      DateTime
  agenda           String?
  sharedNotes      String?
  managerNotes     String? // visible to manager only
  reportNotes      String? // visible to report only
  status           String    @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  manager Worker @relation("OooManager", fields: [managerId], references: [id], onDelete: Cascade)
  report  Worker @relation("OooReport", fields: [reportId], references: [id], onDelete: Cascade)
}

model Feedback {
  id         String   @id @default(cuid())
  aboutId    String
  authorId   String
  kind       String   @default("FEEDBACK") // PRAISE | FEEDBACK | PRIVATE_HR
  visibility String   @default("MANAGER") // PUBLIC | SUBJECT | MANAGER | HR
  body       String
  createdAt  DateTime @default(now())

  about  Worker @relation("FeedbackAbout", fields: [aboutId], references: [id], onDelete: Cascade)
  author Worker @relation("FeedbackAuthor", fields: [authorId], references: [id])
}

// Confidential employee-relations case management
model HrCase {
  id           String    @id @default(cuid())
  workerId     String
  caseType     String // COACHING | VERBAL_WARNING | WRITTEN_WARNING | FINAL_WARNING | PIP | INVESTIGATION | COMPLAINT | INCIDENT | CORRECTIVE_ACTION
  title        String
  description  String?
  ownerUserId  String
  status       String    @default("OPEN") // OPEN | MONITORING | RESOLVED | CLOSED
  openedAt     DateTime  @default(now())
  followUpDate DateTime?
  resolution   String?
  closedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  worker Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  notes  HrCaseNote[]
}

model HrCaseNote {
  id           String   @id @default(cuid())
  caseId       String
  authorUserId String
  body         String
  createdAt    DateTime @default(now())

  case HrCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Compensation planning / Benefits / Payroll hub
// ---------------------------------------------------------------------------

model SalaryBand {
  id        String  @id @default(cuid())
  jobFamily String
  jobLevel  String
  geography String  @default("US") // US | PH | ...
  currency  String  @default("USD")
  minAmount Decimal @db.Decimal(14, 2)
  midAmount Decimal @db.Decimal(14, 2)
  maxAmount Decimal @db.Decimal(14, 2)

  @@unique([jobFamily, jobLevel, geography])
}

model BenefitPlan {
  id               String    @id @default(cuid())
  kind             String // MEDICAL | DENTAL | VISION | LIFE | DISABILITY | RETIREMENT_401K | HSA | FSA | OTHER
  name             String
  provider         String?
  description      String?
  employeeCostMonthly Decimal? @db.Decimal(12, 2)
  employerCostMonthly Decimal? @db.Decimal(12, 2)
  waitingPeriodDays Int      @default(0)
  planYearStart    DateTime?
  planYearEnd      DateTime?
  documentId       String?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())

  enrollments BenefitEnrollment[]
}

model BenefitEnrollment {
  id            String    @id @default(cuid())
  workerId      String
  planId        String
  status        String    @default("ELIGIBLE") // ELIGIBLE | ENROLLED | WAIVED | TERMINATED
  coverageLevel String? // EMPLOYEE | EMPLOYEE_SPOUSE | EMPLOYEE_CHILDREN | FAMILY
  dependents    Json      @default("[]")
  employeeContributionMonthly Decimal? @db.Decimal(12, 2)
  employerContributionMonthly Decimal? @db.Decimal(12, 2)
  electedAt     DateTime?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  qleReason     String? // qualifying life event
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  worker Worker      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  plan   BenefitPlan @relation(fields: [planId], references: [id])

  @@unique([workerId, planId, effectiveFrom])
}

model PayrollPeriod {
  id          String   @id @default(cuid())
  legalEntityCode String @default("ALL")
  periodStart DateTime
  periodEnd   DateTime
  payDate     DateTime
  status      String   @default("OPEN") // OPEN | REVIEW | APPROVED | EXPORTED | CLOSED
  approvedById String?
  approvedAt  DateTime?
  exportedAt  DateTime?
  createdAt   DateTime @default(now())

  @@unique([legalEntityCode, periodStart])
}

// ---------------------------------------------------------------------------
// Equipment / Software access / Training
// ---------------------------------------------------------------------------

model EquipmentAsset {
  id          String   @id @default(cuid())
  kind        String // LAPTOP | MONITOR | PHONE | HEADSET | KEYS | ACCESS_CARD | TOOL | VEHICLE | OTHER
  assetTag    String   @unique
  serialNumber String?
  make        String?
  model       String?
  valueUsd    Decimal? @db.Decimal(12, 2)
  condition   String? // NEW | GOOD | FAIR | POOR
  status      String   @default("IN_STOCK") // IN_STOCK | ASSIGNED | IN_REPAIR | RETIRED | LOST
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments EquipmentAssignment[]
}

model EquipmentAssignment {
  id                String    @id @default(cuid())
  assetId           String
  workerId          String
  assignedAt        DateTime  @default(now())
  assignedById      String?
  returnRequired    Boolean   @default(true)
  returnDueDate     DateTime?
  returnedAt        DateTime?
  returnedCondition String?
  notes             String?

  asset  EquipmentAsset @relation(fields: [assetId], references: [id])
  worker Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, returnedAt])
}

model SoftwareApp {
  id           String   @id @default(cuid())
  name         String   @unique
  category     String?
  ownerUserId  String?
  monthlyCostPerSeat Decimal? @db.Decimal(10, 2)
  renewalDate  DateTime?
  provisioningNote String?
  autoProvisionOnboarding Boolean @default(true)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  grants AppAccessGrant[]
}

model AppAccessGrant {
  id          String    @id @default(cuid())
  appId       String
  workerId    String
  accessLevel String    @default("USER") // USER | ADMIN | READONLY
  licenseNote String?
  grantedAt   DateTime  @default(now())
  grantedById String?
  revokedAt   DateTime?
  revokedById String?

  app    SoftwareApp @relation(fields: [appId], references: [id])
  worker Worker      @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, revokedAt])
}

model TrainingCourse {
  id          String   @id @default(cuid())
  title       String
  category    String // SAFETY | CYBERSECURITY | HARASSMENT_PREVENTION | PRODUCT | MANAGEMENT | ERP | CRM | SALES | SOP | OTHER
  description String?
  contentUrl  String?
  documentId  String?
  durationMin Int?
  dueDays     Int      @default(30) // days after assignment
  recurrenceMonths Int? // null = one-time
  // Auto-assignment rules: { workerTypes?, departmentIds?, countries?, workStates?, managerOnly? }
  assignmentRules Json  @default("{}")
  autoAssign  Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  assignments TrainingAssignment[]
}

model TrainingAssignment {
  id          String    @id @default(cuid())
  courseId    String
  workerId    String
  assignedAt  DateTime  @default(now())
  dueDate     DateTime?
  status      String    @default("ASSIGNED") // ASSIGNED | IN_PROGRESS | COMPLETED | OVERDUE | WAIVED
  completedAt DateTime?
  score       Int?
  certificateDocId String?
  expiresAt   DateTime?

  course TrainingCourse @relation(fields: [courseId], references: [id])
  worker Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([courseId, workerId, assignedAt])
}

// ---------------------------------------------------------------------------
// Engagement / Announcements
// ---------------------------------------------------------------------------

model Survey {
  id        String    @id @default(cuid())
  title     String
  kind      String    @default("PULSE") // PULSE | ENGAGEMENT | ENPS | CUSTOM
  anonymous Boolean   @default(true)
  questions Json      @default("[]") // [{id, text, type: SCALE|TEXT|ENPS}]
  audience  Json      @default("{}")
  status    String    @default("DRAFT") // DRAFT | OPEN | CLOSED
  opensAt   DateTime?
  closesAt  DateTime?
  // Anonymity floor: results hidden until at least N responses
  minResponsesToShow Int @default(5)
  createdAt DateTime  @default(now())

  responses SurveyResponse[]
}

model SurveyResponse {
  id        String   @id @default(cuid())
  surveyId  String
  // For anonymous surveys this stores a one-way hash to prevent duplicates
  // without identifying the respondent. For named surveys it's the worker id.
  respondentKey String
  answers   Json
  createdAt DateTime @default(now())

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([surveyId, respondentKey])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  bodyHtml    String
  audience    Json      @default("{}") // { legalEntityIds?, departmentIds?, countries?, workerTypes?, managerOnly? }
  publishAt   DateTime  @default(now())
  expiresAt   DateTime?
  pinned      Boolean   @default(false)
  requiresAck Boolean   @default(false)
  authorUserId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  acks AnnouncementAck[]
}

model AnnouncementAck {
  id             String   @id @default(cuid())
  announcementId String
  workerId       String
  ackedAt        DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  worker       Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([announcementId, workerId])
}

// ---------------------------------------------------------------------------
// Workflow automation / Approvals / Notifications
// ---------------------------------------------------------------------------

model WorkflowDefinition {
  id          String   @id @default(cuid())
  name        String
  description String?
  trigger     String // WORKER_ADDED | START_DATE_APPROACHING | OFFER_ACCEPTED | BIRTHDAY | ANNIVERSARY | TITLE_CHANGED | DEPARTMENT_CHANGED | MANAGER_CHANGED | PTO_SUBMITTED | PTO_APPROVED | TRAINING_OVERDUE | DOCUMENT_EXPIRING | CONTRACT_EXPIRING | REVIEW_CYCLE_STARTED | TERMINATION_SCHEDULED | EQUIPMENT_UNRETURNED
  // { countries?, workerTypes?, departmentIds?, legalEntityIds?, workStates?, tenureDaysGte?, tenureDaysLte? }
  conditions  Json     @default("{}")
  // [{type: CREATE_TASK|SEND_EMAIL|NOTIFY_USER|NOTIFY_ROLE|ASSIGN_TRAINING|ASSIGN_POLICY|REQUEST_DOCUMENT|START_ONBOARDING|START_OFFBOARDING|REQUEST_APPROVAL|WEBHOOK, ...params}]
  actions     Json     @default("[]")
  enabled     Boolean  @default(true)
  isTemplate  Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runs WorkflowRun[]
}

model WorkflowRun {
  id           String   @id @default(cuid())
  definitionId String
  event        Json
  status       String   @default("RUNNING") // RUNNING | SUCCEEDED | FAILED | SKIPPED
  log          Json     @default("[]")
  error        String?
  startedAt    DateTime @default(now())
  finishedAt   DateTime?

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([definitionId, startedAt])
}

model ApprovalRequest {
  id            String   @id @default(cuid())
  kind          String // OFFER | NEW_HIRE | PTO | COMP_CHANGE | PROMOTION | HEADCOUNT | OFFBOARDING | DATA_CHANGE | RECORD_DESTRUCTION
  title         String
  subjectType   String? // e.g. "Worker", "Offer"
  subjectId     String?
  payload       Json     @default("{}")
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELED
  requestedById String
  decidedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  steps ApprovalStep[]
}

// Approval decisions are immutable once made (enforced in service layer + audit).
model ApprovalStep {
  id             String    @id @default(cuid())
  requestId      String
  order          Int
  approverUserId String?
  approverRole   String? // role queue alternative
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED | SKIPPED
  note           String?
  decidedById    String?
  decidedAt      DateTime?

  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, order])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String    @default("INFO") // INFO | TASK | APPROVAL | COMPLIANCE | SYSTEM
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// ---------------------------------------------------------------------------
// Compliance / Retention / Audit
// ---------------------------------------------------------------------------

model ComplianceRule {
  id             String    @id @default(cuid())
  name           String
  category       String // ONBOARDING_FORMS | WORK_AUTHORIZATION | RECORDS | WAGE_HOUR | POLICY | TRAINING | BENEFITS | CONTRACTOR | RETENTION
  jurisdiction   String // US-FED | US-PA | PH | ...
  source         String? // e.g. "USCIS", "IRS", "DOLE"
  sourceUrl      String?
  description    String
  // { workerTypes?, countries?, workStates?, legalEntityIds? }
  appliesTo      Json      @default("{}")
  // { anchor: HIRE_DATE|TERMINATION_DATE|DOCUMENT_EXPIRY|FIXED_DATE, offsetDays?, fixedDate? }
  deadlineRule   Json      @default("{}")
  severity       String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  ownerRoleKey   String    @default("HR_ADMIN")
  status         String    @default("ACTIVE") // ACTIVE | UNDER_REVIEW | RETIRED
  lastReviewedAt DateTime?
  nextReviewAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items ComplianceItem[]
}

model ComplianceItem {
  id       String    @id @default(cuid())
  ruleId   String
  workerId String?
  title    String
  dueDate  DateTime?
  status   String    @default("OPEN") // OPEN | IN_PROGRESS | COMPLETED | WAIVED | OVERDUE
  taskId   String?
  note     String?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rule   ComplianceRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  worker Worker?        @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

model RetentionPolicy {
  id           String  @id @default(cuid())
  recordType   String // PERSONNEL | PAYROLL | TIMEKEEPING | RECRUITING | TAX_FORM | I9 | PERFORMANCE | DISCIPLINARY | CONTRACTOR
  jurisdiction String  @default("US-FED")
  workerType   WorkerType?
  // Retention anchor & length. Destruction always requires explicit approval.
  anchor       String  @default("TERMINATION") // TERMINATION | CREATION | HIRE
  retainYears  Decimal @db.Decimal(4, 1)
  note         String?
  sourceUrl    String?
  active       Boolean @default(true)
  createdAt    DateTime @default(now())
}

// Append-only. UPDATE/DELETE blocked by DB trigger.
model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  actorEmail  String?
  action      String // e.g. auth.login, worker.update, pii.reveal, export.run
  targetType  String?
  targetId    String?
  before      Json?
  after       Json?
  ip          String?
  sessionId   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}

// ---------------------------------------------------------------------------
// Custom fields / Integrations / Email / Imports / Saved reports
// ---------------------------------------------------------------------------

model CustomFieldDef {
  id         String   @id @default(cuid())
  entity     String   @default("WORKER")
  label      String
  key        String   @unique
  fieldType  String // TEXT | NUMBER | CURRENCY | DATE | BOOLEAN | DROPDOWN | MULTI_SELECT | USER | URL
  options    Json     @default("[]")
  required   Boolean  @default(false)
  section    String   @default("Custom")
  // { workerTypes?, countries? }
  appliesTo  Json     @default("{}")
  visibility String   @default("HR") // SELF | MANAGER | HR
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  values CustomFieldValue[]
}

model CustomFieldValue {
  id       String @id @default(cuid())
  defId    String
  workerId String
  value    Json

  def    CustomFieldDef @relation(fields: [defId], references: [id], onDelete: Cascade)
  worker Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([defId, workerId])
}

model Integration {
  id        String   @id @default(cuid())
  kind      String // ENTRA_ID | M365 | OUTLOOK | TEAMS | PROPHET21 | PIPEDRIVE | RINGCENTRAL | QUICKBOOKS | BIGCOMMERCE | CONSTANT_CONTACT | POWER_BI | GDRIVE | NOTION | PAYROLL | BENEFITS | BACKGROUND_CHECK | ESIGN | SLACK
  name      String
  status    String   @default("NOT_CONFIGURED") // NOT_CONFIGURED | CONFIGURED | ERROR | DISABLED
  // Non-secret configuration only. Secrets live in environment variables.
  config    Json     @default("{}")
  enabled   Boolean  @default(false)
  lastSyncAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  url       String
  secretEnc String
  events    Json     @default("[]")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model EmailMessage {
  id          String    @id @default(cuid())
  toEmail     String
  subject     String
  html        String
  text        String?
  templateKey String?
  relatedType String?
  relatedId   String?
  status      String    @default("QUEUED") // QUEUED | SENT | FAILED | OUTBOX
  provider    String?
  error       String?
  attempts    Int       @default(0)
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
}

model ImportJob {
  id          String   @id @default(cuid())
  kind        String // WORKERS | DEPARTMENTS | COMPENSATION | PTO_BALANCES | CONTRACTORS | EQUIPMENT
  fileName    String
  status      String   @default("VALIDATING") // VALIDATING | READY | IMPORTING | COMPLETED | FAILED
  totalRows   Int      @default(0)
  successRows Int      @default(0)
  errorRows   Int      @default(0)
  report      Json     @default("[]") // per-row errors
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ReportDefinition {
  id        String   @id @default(cuid())
  name      String
  kind      String // report key from the report registry
  config    Json     @default("{}") // filters, columns, grouping
  ownerId   String
  schedule  Json? // { cron?, recipients? } — scheduled-report architecture
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Skills and certifications (§ skills inventory)
//
// Distinct from Training: training records that someone *took a course*, this
// records that someone *can do a thing* — and, for a distributor, whether the
// certification behind it is still current. Coverage risk (who is one person
// deep on a critical skill) falls out of the same data.
// ---------------------------------------------------------------------------

model Skill {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String // SAFETY | EQUIPMENT | PRODUCT | SYSTEM | LANGUAGE | LEADERSHIP | TRADE | OTHER
  description String?
  // A certification expires and must be renewed (forklift, OSHA 30). A plain
  // skill does not. Drives the expiry watch and the compliance surface.
  isCertification Boolean @default(false)
  // Losing every holder of a critical skill stops work. Surfaced in coverage.
  isCritical  Boolean  @default(false)
  // Renewal interval for certifications, in months.
  validityMonths Int?
  // Optional course that grants this skill when completed.
  courseId    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workerSkills WorkerSkill[]
  jobRequirements JobSkillRequirement[]

  @@index([category, active])
}

model WorkerSkill {
  id         String    @id @default(cuid())
  workerId   String
  skillId    String
  // 1 Aware · 2 Working · 3 Proficient · 4 Expert · 5 Can teach it
  level      Int       @default(3)
  // A self-reported skill is a claim; a verified one has a named person behind
  // it. Coverage reporting can require verification for critical skills.
  verifiedById String?
  verifiedAt DateTime?
  acquiredAt DateTime?
  expiresAt  DateTime?
  // Evidence: certificate document, training assignment that granted it.
  documentId String?
  sourceType String    @default("MANUAL") // MANUAL | TRAINING | IMPORT
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([workerId, skillId])
  @@index([skillId, expiresAt])
  @@index([expiresAt])
}

model JobSkillRequirement {
  id            String  @id @default(cuid())
  skillId       String
  // Requirements attach either to a requisition (what this opening needs) or
  // to a job family + level (what the role needs in general).
  requisitionId String?
  jobFamily     String?
  jobLevel      String?
  minLevel      Int     @default(3)
  required      Boolean @default(true) // false = nice to have

  skill       Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)
  requisition JobRequisition? @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@index([requisitionId])
  @@index([jobFamily, jobLevel])
}

// ---------------------------------------------------------------------------
// Compensation cycles and pay equity (§ comp planning)
//
// Merit planning happens here instead of in a spreadsheet, and lands as a
// single effective-dated Compensation row per worker at the end. Budget is
// allocated down the org and rolled up live so a manager can see the effect
// of a proposal before submitting it.
// ---------------------------------------------------------------------------

model CompCycle {
  id            String    @id @default(cuid())
  name          String
  status        String    @default("DRAFT") // DRAFT | PLANNING | IN_REVIEW | APPROVED | APPLIED | CANCELED
  effectiveDate DateTime // when approved increases take effect
  // Total pool as a percentage of eligible base pay, and/or an absolute amount.
  budgetPct     Decimal?  @db.Decimal(5, 2)
  budgetAmount  Decimal?  @db.Decimal(14, 2)
  currency      String    @default("USD")
  // Eligibility: { legalEntityIds?, departmentIds?, workerTypes?, minTenureMonths? }
  eligibility   Json      @default("{}")
  guidance      String?
  opensAt       DateTime?
  closesAt      DateTime?
  createdById   String?
  appliedAt     DateTime?
  appliedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  budgets   CompCycleBudget[]
  proposals CompProposal[]

  @@index([status])
}

/** Budget delegated to one manager for their part of the org. */
model CompCycleBudget {
  id            String  @id @default(cuid())
  cycleId       String
  managerId     String
  amount        Decimal @db.Decimal(14, 2)
  currency      String  @default("USD")
  note          String?

  cycle CompCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, managerId])
}

model CompProposal {
  id             String    @id @default(cuid())
  cycleId        String
  workerId       String
  // Snapshot at planning time so the roll-up is stable even if someone's pay
  // changes mid-cycle for another reason.
  currentAmount  Decimal   @db.Decimal(14, 2)
  currency       String    @default("USD")
  rateType       String    @default("ANNUAL")
  proposedAmount Decimal?  @db.Decimal(14, 2)
  increasePct    Decimal?  @db.Decimal(6, 3)
  reason         String    @default("MERIT") // MERIT | PROMOTION | MARKET | EQUITY
  proposedTitle  String?
  proposedLevel  String?
  justification  String?
  status         String    @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED | APPLIED
  proposedById   String?
  submittedAt    DateTime?
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  appliedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  cycle  CompCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  worker Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([cycleId, workerId])
  @@index([cycleId, status])
}

// ---------------------------------------------------------------------------
// Hiring funnel: referrals and talent pool (§ own the funnel)
// ---------------------------------------------------------------------------

model Referral {
  id            String    @id @default(cuid())
  referrerWorkerId String
  candidateId   String?
  requisitionId String?
  // Captured before a Candidate record exists, when someone refers a friend.
  candidateName String
  candidateEmail String?
  candidatePhone String?
  relationship  String? // FORMER_COLLEAGUE | FRIEND | FAMILY | INDUSTRY | OTHER
  note          String?
  status        String    @default("SUBMITTED") // SUBMITTED | LINKED | HIRED | CLOSED
  // Bonus is recorded, never paid by this system — payroll pays it.
  bonusAmount   Decimal?  @db.Decimal(12, 2)
  bonusCurrency String    @default("USD")
  bonusStatus   String    @default("NONE") // NONE | PENDING | APPROVED | PAID | FORFEITED
  bonusEligibleAt DateTime? // usually the referred hire's 90-day mark
  bonusApprovedById String?
  closedReason  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  referrer  Worker     @relation("ReferralsMade", fields: [referrerWorkerId], references: [id], onDelete: Cascade)
  candidate Candidate? @relation(fields: [candidateId], references: [id])

  @@index([referrerWorkerId])
  @@index([status])
  @@index([candidateEmail])
}

/**
 * Silver medallists. Someone interviewed well and lost to a stronger
 * candidate; that is worth remembering rather than leaving as a rejected row.
 */
model TalentPoolEntry {
  id            String    @id @default(cuid())
  candidateId   String
  addedById     String?
  reason        String? // why they are worth revisiting
  jobFamily     String?
  strengthNote  String?
  // Consent and hygiene: we do not keep people forever without a reason.
  reviewBy      DateTime?
  lastContactedAt DateTime?
  status        String    @default("ACTIVE") // ACTIVE | CONTACTED | PLACED | REMOVED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId])
  @@index([status, jobFamily])
}

// ---------------------------------------------------------------------------
// Hourly workforce operations (§ shifts, overtime, breaks)
// ---------------------------------------------------------------------------

model ShiftTemplate {
  id          String  @id @default(cuid())
  name        String  @unique
  locationId  String?
  startTime   String // "06:00" local to the location
  endTime     String // "14:30"
  breakMinutes Int    @default(30)
  color       String?
  active      Boolean @default(true)

  shifts Shift[]
}

model Shift {
  id           String    @id @default(cuid())
  templateId   String?
  locationId   String?
  departmentId String?
  date         DateTime // the local calendar day the shift belongs to
  startsAt     DateTime
  endsAt       DateTime
  breakMinutes Int       @default(30)
  role         String? // "Picker", "Driver", "Counter Sales"
  // Draft shifts are invisible to workers. Publishing is an explicit act so a
  // schedule cannot be half-changed in front of the people working it.
  status       String    @default("DRAFT") // DRAFT | PUBLISHED | CANCELED
  publishedAt  DateTime?
  publishedById String?
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  template    ShiftTemplate? @relation(fields: [templateId], references: [id])
  assignments ShiftAssignment[]

  @@index([date, status])
  @@index([locationId, date])
}

model ShiftAssignment {
  id        String   @id @default(cuid())
  shiftId   String
  workerId  String
  status    String   @default("ASSIGNED") // ASSIGNED | ACCEPTED | DECLINED | NO_SHOW | COMPLETED
  assignedById String?
  respondedAt DateTime?
  note      String?
  createdAt DateTime @default(now())

  shift  Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([shiftId, workerId])
  @@index([workerId])
}

/**
 * Meal and rest break rules, as data rather than code, because they are
 * jurisdictional and they change. Same shape as ComplianceRule: every rule
 * carries where it applies and the authority behind it.
 */
model BreakRule {
  id            String   @id @default(cuid())
  jurisdiction  String // "US-PA", "US-CA", "PH"
  name          String
  // Applies once a shift reaches this many minutes...
  afterMinutes  Int
  // ...requiring a break of at least this long.
  breakMinutes  Int
  paid          Boolean  @default(false)
  kind          String   @default("MEAL") // MEAL | REST
  appliesToMinors Boolean @default(false)
  sourceUrl     String?
  note          String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([jurisdiction, active])
}
