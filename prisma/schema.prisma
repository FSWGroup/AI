// FSW Talent Scout Assessment — database schema.
//
// Design principles:
//  - Immutable history: candidates' attempts reference frozen QuestionVersion
//    rows and a frozen AssessmentVersion, so later edits never change what a
//    historical attempt saw or how it renders.
//  - Raw data is never destroyed by scoring: raw responses, raw scores, and
//    scaled/banded scores are stored side by side with the norm table and
//    scoring version that produced them.
//  - Webcam video lives in object storage, never in this database; only chunk
//    manifests and access audit trails live here.

generator client {
  provider = "prisma-client-js"
  // "native" for local dev/build machines; rhel for AWS-Lambda-based hosts
  // (Netlify Functions, Vercel) where the runtime differs from the build OS.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity, access control, audit
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  HR_ADMIN
  HIRING_MANAGER
  ASSESSMENT_ADMIN
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole
  active       Boolean  @default(true)
  /// IANA zone this person works in. A distributed panel does not share one,
  /// and availability written as "9 to 5" means nothing without it.
  timeZone     String   @default("Asia/Manila")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions            Session[]
  auditEvents         AuditEvent[]
  invitationsSent     Invitation[]             @relation("InvitedBy")
  jobAssignments      JobProfileAssignment[]
  questionsCreated    Question[]               @relation("QuestionCreatedBy")
  questionsReviewed   QuestionVersion[]        @relation("QuestionReviewedBy")
  accommodationsGiven AccommodationOverride[]  @relation("AccommodationApprovedBy")
  notes               CandidateNote[]

  // Recruiting
  requisitionsCreated   Requisition[]           @relation("RequisitionCreatedBy")
  requisitionApprovals  RequisitionApproval[]   @relation("RequisitionApprover")
  hiringTeamMemberships HiringTeamMember[]
  applicationsReferred  Application[]           @relation("ApplicationReferredBy")
  stageEventsActed      ApplicationStageEvent[]
  applicationNotes      ApplicationNote[]
  interviewKitsCreated  InterviewKit[]
  interviewsScheduled   Interview[]             @relation("InterviewScheduledBy")
  interviewParticipation InterviewParticipant[]
  scorecards            Scorecard[]
  referenceChecks       ReferenceCheck[]
  offersCreated         Offer[]                 @relation("OfferCreatedBy")
  offerApprovals        OfferApproval[]         @relation("OfferApprover")
  offerTemplates        OfferLetterTemplate[]
  requisitionEvents     RequisitionEvent[]
  reviewRoundsRequested ReviewRound[]           @relation("ReviewRoundRequestedBy")
  candidateReviews      CandidateReview[]
  socialChecksReviewed  SocialMediaCheck[]      @relation("SocialCheckReviewer")
  socialChecksRequested SocialMediaCheck[]      @relation("SocialCheckRequestedBy")
  backgroundChecksRequested BackgroundCheck[]   @relation("BackgroundCheckRequestedBy")
  hiresManaged          Hire[]                  @relation("HireManager")
  hiresCreated          Hire[]                  @relation("HireCreatedBy")
  performanceReviews    PerformanceReview[]     @relation("PerformanceRater")
  performanceMetrics    PerformanceMetric[]     @relation("MetricCreatedBy")
  studiesCreated        ValidationStudy[]       @relation("StudyCreatedBy")
  studiesComputed       ValidationStudy[]       @relation("StudyComputedBy")
  workSamplesCreated    WorkSample[]            @relation("WorkSampleCreatedBy")
  workSamplesAssigned   WorkSampleAssignment[]  @relation("WorkSampleAssignedBy")
  workSampleGrades      WorkSampleGrade[]       @relation("WorkSampleGrader")
  talentProfilesCreated TalentProfile[]         @relation("TalentProfileCreatedBy")
  talentTagsAdded       TalentProfileTag[]      @relation("TalentTagAddedBy")
  talentPoolsCreated    TalentPool[]            @relation("TalentPoolCreatedBy")
  talentPoolMembersAdded TalentPoolMember[]     @relation("TalentPoolMemberAddedBy")
  talentOutreachSent    TalentOutreach[]        @relation("TalentOutreachSentBy")
  availabilityRules     AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  schedulingRequests    SchedulingRequest[]     @relation("SchedulingRequestCreatedBy")
  schedulingPanels      SchedulingPanelist[]
  scheduledReminders    ScheduledReminder[]
  recordingConsents     InterviewRecordingConsent[]
  recordingsUploaded    InterviewRecording[]       @relation("RecordingUploadedBy")
  evidenceDismissed     InterviewEvidence[]        @relation("EvidenceDismissedBy")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

/// Restricts a HIRING_MANAGER (or scoped VIEWER) to specific job profiles.
model JobProfileAssignment {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobProfileId String
  jobProfile   JobProfile @relation(fields: [jobProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, jobProfileId])
}

model AuditEvent {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Who acted when it was not a signed-in admin (e.g. "system:retention").
  actorLabel    String?
  action        String
  entityType    String
  entityId      String?
  previousValue Json?
  newValue      Json?
  ip            String?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

// ---------------------------------------------------------------------------
// Organization configuration
// ---------------------------------------------------------------------------

/// Single-row organization settings (id is always "org").
model OrgSettings {
  id                        String   @id @default("org")
  companyName               String   @default("FSW Group")
  logoUrl                   String?
  privacyContactEmail       String?
  accommodationContactEmail String?
  hrNotificationEmail       String?
  assessmentDisclaimer      String?
  permittedAdminDomains     String[] @default([])
  /// Current-awareness (dated) questions allowed on new forms.
  currentAwarenessEnabled   Boolean  @default(false)
  /// EEO/adverse-impact module is disabled unless explicitly configured.
  eeoModuleEnabled          Boolean  @default(false)
  /// When on, candidates may view a strengths-and-development report about
  /// their own results. Never shows benchmarks, validity, or integrity data.
  candidateFeedbackEnabled  Boolean  @default(false)
  /// Social media review is off until an organization enables it deliberately.
  socialCheckEnabled        Boolean  @default(false)
  /// Default Checkr package ordered for new background checks.
  checkrDefaultPackage      String?
  privacyNoticeVersion      String   @default("1.0")
  privacyNoticeConfigured   Boolean  @default(false)
  /// Roles allowed to view webcam recordings. Least privilege by default.
  recordingAccessRoles      String[] @default(["SUPER_ADMIN", "HR_ADMIN"])
  storageConfigured         Boolean  @default(false)
  httpsConfirmed            Boolean  @default(false)
  /// IANA zone the organization schedules in. Every stored instant is UTC;
  /// this decides how availability windows and slots are rendered.
  timeZone                  String   @default("Asia/Manila")
  updatedAt                 DateTime @updatedAt
}

enum RetentionRecordType {
  ASSESSMENT_ANSWERS
  SCORE_REPORT_DATA
  INVITATION_RECORDS
  INTEGRITY_EVENT_LOGS
  WEBCAM_RECORDINGS
  AUDIT_RECORDS
  /// Interview recordings and their transcripts.
  INTERVIEW_RECORDINGS
  /// Talent-pool membership. A candidate who agreed to be kept in mind agreed
  /// to it for a period, not forever.
  TALENT_POOL_RECORDS
}

model RetentionPolicy {
  id            String              @id @default(cuid())
  recordType    RetentionRecordType @unique
  retentionDays Int?
  /// Null retentionDays = keep indefinitely until policy is set.
  updatedById   String?
  updatedAt     DateTime            @updatedAt
  createdAt     DateTime            @default(now())
}

model LegalHold {
  id          String    @id @default(cuid())
  /// "GLOBAL", or "CANDIDATE:<id>", or "ATTEMPT:<id>".
  scope       String
  reason      String
  active      Boolean   @default(true)
  createdById String?
  createdAt   DateTime  @default(now())
  releasedAt  DateTime?

  @@index([active])
}

model RetentionRun {
  id          String   @id @default(cuid())
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  summary     Json?
}

// ---------------------------------------------------------------------------
// Assessment constructs, questions, versions
// ---------------------------------------------------------------------------

enum Construct {
  MENTAL_ACUITY
  BUSINESS_TERMS
  AWARENESS_MEMORY
  VOCABULARY
  NUMERICAL_PERCEPTION
  MECHANICAL_INTEREST
  ENERGY
  FLEXIBILITY
  ORGANIZATION
  COMMUNICATION
  EMOTIONAL_DEVELOPMENT
  ASSERTIVENESS
  COMPETITIVENESS
  MENTAL_TOUGHNESS
  QUESTIONING_PROBING
  MOTIVATION
  DISTORTION
  EQUIVOCATION
}

enum QuestionStatus {
  DRAFT
  REVIEW
  APPROVED
  RETIRED
}

enum QuestionKind {
  MULTIPLE_CHOICE
  LIKERT_STATEMENT
  MEMORY_STUDY
  STRING_COMPARISON
}

/// Head record for a question. Candidate-facing payloads never include the
/// internal id, construct, or scoring fields — only QuestionVersion.publicId.
model Question {
  id          String         @id @default(cuid())
  construct   Construct
  subtype     String
  kind        QuestionKind
  status      QuestionStatus @default(DRAFT)
  /// Latest version number; versions are immutable snapshots.
  currentVersion Int         @default(1)
  source      String         @default("fsw_original")
  createdById String?
  createdBy   User?          @relation("QuestionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  /// For dated current-awareness items: date after which the item is stale.
  currentAwarenessExpiry DateTime?

  versions QuestionVersion[]

  @@index([construct, status])
  @@index([status])
}

/// Immutable snapshot of a question's content and scoring at a version.
model QuestionVersion {
  id       String @id @default(cuid())
  /// Opaque identifier safe to expose to candidates. Reveals nothing.
  publicId String @unique @default(cuid())

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  version    Int

  construct Construct
  subtype   String
  kind      QuestionKind
  prompt    String
  /// Stimulus text for MEMORY_STUDY cards; study seconds etc.
  promptData Json?
  /// Array of choice strings for MULTIPLE_CHOICE / STRING_COMPARISON.
  choices   Json?
  /// Never sent to clients. Index into choices.
  correctIndex Int?
  /// Admin-only rationale. Never sent to candidates.
  explanation String?
  difficulty  Int      @default(2)
  weight      Float    @default(1)
  reverseCoded Boolean @default(false)
  /// Consistency-pair key for equivocation checks.
  pairKey     String?
  /// True for impression-management (DISTORTION) items.
  impressionManagement Boolean @default(false)

  reviewedById String?
  reviewedBy   User?     @relation("QuestionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())

  formQuestions    AssessmentFormQuestion[]
  attemptQuestions AttemptQuestion[]
  itemStats        ItemStatistic[]

  @@unique([questionId, version])
  @@index([construct])
}

enum AssessmentVersionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

/// A frozen, versioned assessment form: sections, timers, question pool,
/// scoring + narrative versions. Every attempt records exactly one of these.
model AssessmentVersion {
  id            String                  @id @default(cuid())
  name          String
  versionNumber Int
  status        AssessmentVersionStatus @default(DRAFT)
  description   String?
  scoringVersion   String @default("1.0")
  narrativeVersion String @default("1.0")
  createdAt     DateTime @default(now())
  activatedAt   DateTime?
  retiredAt     DateTime?

  sections      SectionDefinition[]
  formQuestions AssessmentFormQuestion[]
  invitations   Invitation[]
  attempts      Attempt[]
  normTables    NormTable[]
  jobProfiles   JobProfile[] @relation("ProfileAssessmentVersion")

  @@unique([name, versionNumber])
}

model SectionDefinition {
  id                  String            @id @default(cuid())
  assessmentVersionId String
  assessmentVersion   AssessmentVersion @relation(fields: [assessmentVersionId], references: [id], onDelete: Cascade)
  /// Section key, e.g. "BEHAVIORAL", "MENTAL_ACUITY".
  key          String
  title        String
  orderIndex   Int
  timed        Boolean @default(false)
  durationSeconds Int?
  /// How many questions to serve from the pool for this section.
  questionCount Int
  instructions String
  /// If true, item order is randomized within difficulty buckets per attempt.
  randomize    Boolean @default(true)

  @@unique([assessmentVersionId, key])
  @@index([assessmentVersionId, orderIndex])
}

/// The question pool of a form version (references immutable versions).
model AssessmentFormQuestion {
  id                  String            @id @default(cuid())
  assessmentVersionId String
  assessmentVersion   AssessmentVersion @relation(fields: [assessmentVersionId], references: [id], onDelete: Cascade)
  sectionKey          String
  questionVersionId   String
  questionVersion     QuestionVersion   @relation(fields: [questionVersionId], references: [id])
  /// Equivalent-difficulty bucket used for constrained randomization.
  difficultyBucket    Int               @default(2)
  /// Fixed ordering anchor within the section (study cards first, etc.).
  orderHint           Int               @default(0)

  @@unique([assessmentVersionId, sectionKey, questionVersionId])
  @@index([assessmentVersionId, sectionKey])
}

// ---------------------------------------------------------------------------
// Jobs and benchmarks
// ---------------------------------------------------------------------------

model JobProfile {
  id          String  @id @default(cuid())
  name        String
  description String?
  /// Full job description text. Drives AI-proposed benchmarks and the
  /// role-tailored assessment form; retained for audit of how a benchmark
  /// was arrived at.
  jobDescription String?
  isSalesRole Boolean @default(false)
  leadershipModuleEnabled Boolean @default(false)
  active      Boolean @default(true)
  /// Optional role-tailored assessment form. When set, invitations for this
  /// profile's openings use it instead of the default active version.
  assessmentVersionId String?
  assessmentVersion   AssessmentVersion? @relation("ProfileAssessmentVersion", fields: [assessmentVersionId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  benchmarks  JobDimensionBenchmark[]
  openings    JobOpening[]
  assignments JobProfileAssignment[]
  concernRules AreaOfConcernRule[]
  aiAnalyses  AiAnalysis[]
  requisitions Requisition[]
  hires       Hire[]
  validationStudies ValidationStudy[]
  workSamples WorkSample[]
  talentPools TalentPool[]
}


model JobDimensionBenchmark {
  id           String     @id @default(cuid())
  jobProfileId String
  jobProfile   JobProfile @relation(fields: [jobProfileId], references: [id], onDelete: Cascade)
  construct    Construct
  minScore     Int
  maxScore     Int
  required     Boolean    @default(true)
  enabled      Boolean    @default(true)
  weight       Float      @default(1)
  note         String?

  @@unique([jobProfileId, construct])
}

/// Configurable critical-attention rules ("Additional Interview Attention
/// Recommended" — never automatic failure).
model AreaOfConcernRule {
  id           String     @id @default(cuid())
  jobProfileId String
  jobProfile   JobProfile @relation(fields: [jobProfileId], references: [id], onDelete: Cascade)
  construct    Construct
  /// Scores at or below this band trigger the attention flag.
  maxBand      Int
  label        String     @default("Additional Interview Attention Recommended")
  enabled      Boolean    @default(true)

  @@unique([jobProfileId, construct])
}

enum JobOpeningStatus {
  OPEN
  PAUSED
  CLOSED
}

model JobOpening {
  id           String           @id @default(cuid())
  jobProfileId String
  jobProfile   JobProfile       @relation(fields: [jobProfileId], references: [id])
  title        String
  status       JobOpeningStatus @default(OPEN)
  createdAt    DateTime         @default(now())

  invitations Invitation[]
  attempts    Attempt[]
  requisition Requisition?
}

// ---------------------------------------------------------------------------
// Composite definitions (sales traits, leadership) — transparent, DB-backed
// ---------------------------------------------------------------------------

enum CompositeCategory {
  SALES
  LEADERSHIP
}

model CompositeDefinition {
  id       String            @id @default(cuid())
  key      String            @unique
  name     String
  category CompositeCategory
  /// [{ "construct": "MENTAL_TOUGHNESS", "weight": 1 }, ...]
  components Json
  description String?
  version  String            @default("1.0")
  orderIndex Int             @default(0)
  active   Boolean           @default(true)
}

// ---------------------------------------------------------------------------
// Candidates, invitations, attempts
// ---------------------------------------------------------------------------

model Candidate {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitations  Invitation[]
  attempts     Attempt[]
  notes        CandidateNote[]
  documents    CandidateDocument[]
  applications Application[]
  hires        Hire[]
  talentProfile TalentProfile?

  @@index([email])
}

model CandidateNote {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body        String
  createdAt   DateTime  @default(now())
}

enum InvitationStatus {
  PENDING
  OPENED
  STARTED
  COMPLETED
  EXPIRED
  REVOKED
}

model Invitation {
  id                  String            @id @default(cuid())
  candidateId         String
  candidate           Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobOpeningId        String
  jobOpening          JobOpening        @relation(fields: [jobOpeningId], references: [id])
  assessmentVersionId String
  assessmentVersion   AssessmentVersion @relation(fields: [assessmentVersionId], references: [id])
  /// SHA-256 of the invitation token. Raw token exists only in the emailed URL.
  tokenHash           String            @unique
  /// Human-readable assessment code (not a secret by itself).
  code                String            @unique
  status              InvitationStatus  @default(PENDING)
  expiresAt           DateTime
  invitedById         String?
  invitedBy           User?             @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  /// Set when the assessment was issued from a recruiting pipeline stage
  /// rather than invited directly.
  applicationId       String?
  application         Application?      @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  createdAt           DateTime          @default(now())

  attempts Attempt[]

  @@index([candidateId])
  @@index([status])
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  INTERRUPTED
  COMPLETED
  EXPIRED
  INVALIDATED
}

model Attempt {
  id                  String            @id @default(cuid())
  invitationId        String
  invitation          Invitation        @relation(fields: [invitationId], references: [id])
  candidateId         String
  candidate           Candidate         @relation(fields: [candidateId], references: [id])
  jobOpeningId        String
  jobOpening          JobOpening        @relation(fields: [jobOpeningId], references: [id])
  assessmentVersionId String
  assessmentVersion   AssessmentVersion @relation(fields: [assessmentVersionId], references: [id])
  attemptNumber       Int               @default(1)
  /// Candidate-friendly Record ID shown for support/recovery, e.g. "FW-8342-KQ".
  recordId            String            @unique
  /// SHA-256 of the resume token (magic-link secret).
  resumeTokenHash     String            @unique
  status              AttemptStatus     @default(NOT_STARTED)
  /// Entry-flow progress: which pre-assessment screen the candidate reached.
  entryStep           String            @default("welcome")
  startedAt           DateTime?
  completedAt         DateTime?
  invalidatedReason   String?
  /// Accommodation overrides applied to this attempt (timing multiplier etc.).
  timeMultiplier      Float             @default(1)
  cameraExempt        Boolean           @default(false)
  untimed             Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  sections        AttemptSection[]
  questions       AttemptQuestion[]
  responses       Response[]
  scores          Score[]
  compositeScores CompositeScore[]
  integrityEvents IntegrityEvent[]
  consents        ConsentRecord[]
  recordings      Recording[]
  reports         Report[]
  accommodations  AccommodationOverride[]
  documents       CandidateDocument[]
  aiAnalyses      AiAnalysis[]
  hire            Hire?

  @@index([candidateId])
  @@index([jobOpeningId])
  @@index([status])
}

enum AttemptSectionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

model AttemptSection {
  id         String               @id @default(cuid())
  attemptId  String
  attempt    Attempt              @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  sectionKey String
  orderIndex Int
  status     AttemptSectionStatus @default(PENDING)
  timed      Boolean
  /// Effective duration after accommodations. Null = untimed.
  durationSeconds Int?
  startedAt  DateTime?
  /// Server-authoritative deadline. Never recalculated from client time.
  expiresAt  DateTime?
  completedAt DateTime?

  @@unique([attemptId, sectionKey])
  @@index([attemptId, orderIndex])
}

/// The frozen, ordered question list actually served to one attempt.
model AttemptQuestion {
  id                String          @id @default(cuid())
  attemptId         String
  attempt           Attempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  sectionKey        String
  orderIndex        Int
  questionVersionId String
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id])

  response Response?

  @@unique([attemptId, sectionKey, orderIndex])
  @@index([attemptId, sectionKey])
}

model Response {
  id                String          @id @default(cuid())
  attemptId         String
  attempt           Attempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptQuestionId String          @unique
  attemptQuestion   AttemptQuestion @relation(fields: [attemptQuestionId], references: [id], onDelete: Cascade)
  /// Choice index for MC/Likert (0-based). Null while unanswered.
  value             Int?
  answeredAt        DateTime?
  firstViewedAt     DateTime?
  responseTimeMs    Int?
  changedCount      Int             @default(0)
  /// Scored server-side; null for unscored kinds.
  isCorrect         Boolean?
  unanswered        Boolean         @default(true)

  @@index([attemptId])
}

// ---------------------------------------------------------------------------
// Scoring, norms, reports
// ---------------------------------------------------------------------------

enum BandType {
  PROVISIONAL
  STANINE
}

model NormTable {
  id                  String   @id @default(cuid())
  construct           Construct
  assessmentVersionId String?
  assessmentVersion   AssessmentVersion? @relation(fields: [assessmentVersionId], references: [id])
  population          String
  effectiveDate       DateTime
  sampleSize          Int
  methodology         String
  /// Ordered raw-score (or theta) upper bounds for bands 1..8; band 9 above.
  /// [{ "band": 1, "maxRaw": 4 }, ...] or z-thresholds per methodology.
  thresholds          Json
  /// Raw-to-percentile curve from the norming sample, one point per whole
  /// percentile: [{ "raw": 12, "percentile": 40 }, ...]. Lets a report state
  /// where a person actually stands rather than approximating it from the
  /// midpoint of their band.
  percentileCurve     Json?
  /// ACTIVE | DRAFT | RETIRED. Only ACTIVE tables band new attempts, and
  /// only one per construct is ACTIVE at a time.
  status              String   @default("ACTIVE")
  /// The validity study this table was generated from, when it came from one.
  /// A table with no study behind it is an externally supplied norm and says
  /// so in `methodology`.
  sourceStudyId       String?
  sourceStudy         ValidationStudy? @relation(fields: [sourceStudyId], references: [id], onDelete: SetNull)
  createdAt           DateTime @default(now())

  scores Score[]

  @@index([construct])
  @@index([status])
}

model Score {
  id             String    @id @default(cuid())
  attemptId      String
  attempt        Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  construct      Construct
  rawScore       Float
  /// Normalized 0-100 internal scale (kept alongside raw, never replacing it).
  scaledScore    Float
  percentile     Float?
  band           Int
  bandType       BandType
  normTableId    String?
  normTable      NormTable? @relation(fields: [normTableId], references: [id], onDelete: SetNull)
  scoringVersion String
  /// Construct-specific diagnostics (middle count, pair inconsistency, etc.).
  detail         Json?
  createdAt      DateTime  @default(now())

  @@unique([attemptId, construct])
}

model CompositeScore {
  id             String  @id @default(cuid())
  attemptId      String
  attempt        Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  key            String
  name           String
  category       CompositeCategory
  value          Float
  band           Int
  formulaVersion String
  detail         Json?

  @@unique([attemptId, key])
}

enum ReportStatus {
  PENDING
  READY
  FAILED
}

model Report {
  id               String       @id @default(cuid())
  attemptId        String
  attempt          Attempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  status           ReportStatus @default(PENDING)
  scoringVersion   String
  narrativeVersion String
  /// Benchmark values frozen at generation time for reproducibility.
  benchmarkSnapshot Json
  /// Fully rendered report data (sections, narratives, selections).
  payload          Json?
  pdfObjectKey     String?
  version          Int          @default(1)
  generatedAt      DateTime?
  createdAt        DateTime     @default(now())

  @@index([attemptId])
}

// ---------------------------------------------------------------------------
// Narrative / interview / development templates (seeded, versioned)
// ---------------------------------------------------------------------------

model NarrativeTemplate {
  id        String    @id @default(cuid())
  construct Construct
  /// "BAND_1".."BAND_9", "RANGE_BELOW", "RANGE_WITHIN", "RANGE_ABOVE",
  /// or for validity: "LEVEL_NORMAL", "LEVEL_ELEVATED", "LEVEL_HIGH".
  slot      String
  text      String
  version   String    @default("1.0")
  active    Boolean   @default(true)

  @@unique([construct, slot, version])
}

model InterviewQuestionTemplate {
  id        String    @id @default(cuid())
  construct Construct
  focus     String // BELOW_RANGE | ABOVE_RANGE | VALIDITY
  measures  String
  /// [{question, altWording, listenFor}]
  questions Json
  version   String    @default("1.0")
  active    Boolean   @default(true)

  @@unique([construct, focus, version])
}

model DevelopmentTemplate {
  id              String    @id @default(cuid())
  construct       Construct
  recommendations Json
  version         String    @default("1.0")
  active          Boolean   @default(true)

  @@unique([construct, version])
}

// ---------------------------------------------------------------------------
// Recording, consent, integrity
// ---------------------------------------------------------------------------

enum RecordingStatus {
  ACTIVE
  FINALIZED
  INCOMPLETE
  DELETED
}

model Recording {
  id        String          @id @default(cuid())
  attemptId String
  attempt   Attempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  /// One recording session per continuous MediaRecorder run.
  sessionId String          @unique
  status    RecordingStatus @default(ACTIVE)
  mimeType  String          @default("video/webm")
  startedAt DateTime        @default(now())
  endedAt   DateTime?
  /// Set when the client-declared final sequence is fully uploaded.
  expectedChunks Int?
  deletedAt DateTime?

  chunks RecordingChunk[]

  @@index([attemptId])
}

enum ChunkUploadStatus {
  PENDING
  UPLOADED
  FAILED
}

model RecordingChunk {
  id          String            @id @default(cuid())
  recordingId String
  recording   Recording         @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  sequence    Int
  objectKey   String
  sizeBytes   Int?
  checksum    String?
  startedAt   DateTime?
  endedAt     DateTime?
  status      ChunkUploadStatus @default(PENDING)
  uploadedAt  DateTime?

  @@unique([recordingId, sequence])
}

model ConsentRecord {
  id            String   @id @default(cuid())
  attemptId     String
  attempt       Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  /// e.g. "recording", "rules".
  consentType   String
  noticeVersion String
  consentText   String
  ip            String?
  userAgent     String?
  consentedAt   DateTime @default(now())

  @@index([attemptId])
}

model IntegrityEvent {
  id         String   @id @default(cuid())
  attemptId  String
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  /// Objective event types only (TAB_HIDDEN, CAMERA_INTERRUPTED, ...).
  type       String
  occurredAt DateTime @default(now())
  meta       Json?

  @@index([attemptId, occurredAt])
}

enum AccommodationType {
  EXTENDED_TIME
  CAMERA_EXEMPT
  UNTIMED
  ALTERNATE_PRESENTATION
  IN_PERSON_ADMINISTRATION
}

model AccommodationOverride {
  id           String            @id @default(cuid())
  attemptId    String
  attempt      Attempt           @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  type         AccommodationType
  /// e.g. 1.5 for time-and-a-half. Only for EXTENDED_TIME.
  timeMultiplier Float?
  note         String?
  approvedById String?
  approvedBy   User?             @relation("AccommodationApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())
}

// ---------------------------------------------------------------------------
// Candidate documents (résumés) and AI decision-support analyses
// ---------------------------------------------------------------------------

enum DocumentKind {
  RESUME
  COVER_LETTER
  OTHER
}

/// A document supplied for a candidate. Files live in private object
/// storage; only extracted text and metadata live here.
model CandidateDocument {
  id           String       @id @default(cuid())
  candidateId  String
  candidate    Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  attemptId    String?
  attempt      Attempt?     @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  applicationId String?
  application  Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  kind         DocumentKind @default(RESUME)
  fileName     String
  mimeType     String
  sizeBytes    Int
  objectKey    String?
  /// Text extracted for analysis. Never shown to candidates.
  extractedText String?
  /// Set when automatic extraction failed and text was pasted instead.
  textSource   String       @default("extracted")
  uploadedById String?
  createdAt    DateTime     @default(now())

  analyses AiAnalysis[]

  @@index([candidateId])
  @@index([attemptId])
}

enum AiAnalysisKind {
  CANDIDATE_FIT
  JOB_DESCRIPTION
}

enum AiAnalysisStatus {
  PENDING
  READY
  FAILED
}

/// An AI-generated, human-reviewed decision-support artifact.
///
/// These are advisory only: they never change assessment scores, never
/// produce a hire/reject recommendation, and are always attributed to the
/// admin who requested them. Inputs, model, and prompt version are stored so
/// any output can be traced back to what produced it.
model AiAnalysis {
  id           String           @id @default(cuid())
  kind         AiAnalysisKind
  status       AiAnalysisStatus @default(PENDING)
  attemptId    String?
  attempt      Attempt?         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  jobProfileId String?
  jobProfile   JobProfile?      @relation(fields: [jobProfileId], references: [id], onDelete: Cascade)
  documentId   String?
  document     CandidateDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  model        String
  promptVersion String
  /// Structured result. Shape depends on `kind`.
  output       Json?
  error        String?
  /// Token usage for cost visibility.
  inputTokens  Int?
  outputTokens Int?
  requestedById String?
  createdAt    DateTime         @default(now())
  completedAt  DateTime?

  @@index([attemptId])
  @@index([jobProfileId])
}

// ---------------------------------------------------------------------------
// Analytics / calibration (anonymous aggregates)
// ---------------------------------------------------------------------------

model ItemStatistic {
  id                String          @id @default(cuid())
  questionVersionId String          @unique
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)
  administered      Int             @default(0)
  correctCount      Int             @default(0)
  unansweredCount   Int             @default(0)
  totalResponseMs   BigInt          @default(0)
  updatedAt         DateTime        @updatedAt
}

// ---------------------------------------------------------------------------
// Email outbox (console/dev provider persists here; real providers log here)
// ---------------------------------------------------------------------------

model EmailMessage {
  id        String   @id @default(cuid())
  toEmail   String
  template  String
  subject   String
  bodyText  String
  status    String   @default("SENT")
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Voluntary EEO data (adverse-impact module). Disabled unless configured.
// Stored separately; never joined into candidate result views.
// ---------------------------------------------------------------------------

model EeoRecord {
  id        String   @id @default(cuid())
  /// Deliberately NOT foreign keys — linkage only through these opaque
  /// references, resolved solely by the compliance module. Keeping them
  /// unrelated means no ordinary candidate query can ever join to them.
  candidateRef String
  attemptRef   String  @unique
  jobProfileRef String?
  jobOpeningId String?
  /// Self-reported, voluntary, categorical data as configured by compliance.
  /// A declined question is stored as "DECLINE" and excluded from analysis.
  data      Json
  createdAt DateTime @default(now())

  @@index([jobOpeningId])
  @@index([jobProfileRef])
}

// ===========================================================================
// RECRUITING (ATS): requisition -> sourcing -> pipeline -> interviews -> offer
//
// Model shape follows the structured-hiring pattern the established tools use:
// a Candidate is a person, and an Application is that person's participation
// in one Requisition. A person applying to three roles is one Candidate with
// three Applications, which is what makes duplicate detection, source
// attribution, and cross-role reporting possible at all.
//
// Everything a human decides is recorded as an event with an actor, because
// employment decisions have to be reconstructable years later.
// ===========================================================================

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  requisitions Requisition[]
  hires        Hire[]
}

model Location {
  id        String   @id @default(cuid())
  name      String
  city      String?
  region    String?
  /// ISO 3166-1 alpha-2. Job boards require it on every posting.
  country   String   @default("PH")
  postalCode String?
  /// Postings that are fully remote still need a nominal location for feeds.
  remote    Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  requisitions Requisition[]
  hires        Hire[]

  @@unique([name, country])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
}

enum WorkArrangement {
  ONSITE
  HYBRID
  REMOTE
}

enum RequisitionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  OPEN
  ON_HOLD
  FILLED
  CLOSED
  REJECTED
}

model Requisition {
  id             String            @id @default(cuid())
  /// Human-readable reference used on postings and in conversation.
  reference      String            @unique
  title          String
  status         RequisitionStatus @default(DRAFT)
  departmentId   String?
  department     Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  locationId     String?
  location       Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  employmentType EmploymentType    @default(FULL_TIME)
  workArrangement WorkArrangement  @default(ONSITE)
  openings       Int               @default(1)
  /// Compensation range. Publishing it is required in a growing number of
  /// jurisdictions and improves applicant quality everywhere else.
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String            @default("PHP")
  salaryPeriod   String            @default("MONTH")
  salaryPublish  Boolean           @default(false)
  /// Public-facing copy.
  summary        String?
  description    String?
  responsibilities String?
  requirements   String?
  benefits       String?
  /// Internal-only context for the hiring team.
  internalNotes  String?
  /// Assessment linkage: the benchmark profile and the opening that
  /// assessment invitations are issued against.
  jobProfileId   String?
  jobProfile     JobProfile?       @relation(fields: [jobProfileId], references: [id], onDelete: SetNull)
  jobOpeningId   String?           @unique
  jobOpening     JobOpening?       @relation(fields: [jobOpeningId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?             @relation("RequisitionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  openedAt       DateTime?
  closedAt       DateTime?
  targetStartDate DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  approvals    RequisitionApproval[]
  team         HiringTeamMember[]
  stages       PipelineStage[]
  postings     JobPosting[]
  applications Application[]
  screeningQuestions ScreeningQuestion[]
  offers       Offer[]
  events       RequisitionEvent[]
  reviewRounds ReviewRound[]
  hires        Hire[]
  talentOutreach TalentOutreach[]

  @@index([status])
  @@index([departmentId])
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

/// One step in a requisition's approval chain. Steps are ordered; a rejection
/// stops the chain and returns the requisition to draft.
model RequisitionApproval {
  id            String           @id @default(cuid())
  requisitionId String
  requisition   Requisition      @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  stepIndex     Int
  approverId    String
  approver      User             @relation("RequisitionApprover", fields: [approverId], references: [id], onDelete: Cascade)
  decision      ApprovalDecision @default(PENDING)
  comment       String?
  decidedAt     DateTime?
  createdAt     DateTime         @default(now())

  @@unique([requisitionId, stepIndex])
  @@index([approverId, decision])
}

enum HiringTeamRole {
  RECRUITER
  HIRING_MANAGER
  INTERVIEWER
  COORDINATOR
  APPROVER
}

model HiringTeamMember {
  id            String         @id @default(cuid())
  requisitionId String
  requisition   Requisition    @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          HiringTeamRole
  createdAt     DateTime       @default(now())

  @@unique([requisitionId, userId, role])
  @@index([userId])
}

/// What a stage is FOR, which drives the behavior the app attaches to it.
/// The label is free text; the kind is the contract.
enum StageKind {
  APPLIED
  SCREEN
  ASSESSMENT
  WORK_SAMPLE
  INTERVIEW
  REFERENCE
  OFFER
  HIRED
}

model PipelineStage {
  id            String      @id @default(cuid())
  requisitionId String
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  name          String
  kind          StageKind
  orderIndex    Int
  /// Interview kit used when this stage is an INTERVIEW stage.
  interviewKitId String?
  interviewKit   InterviewKit? @relation(fields: [interviewKitId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  applications      Application[]
  stageHistory      ApplicationStageEvent[]
  interviews        Interview[]
  schedulingRequests SchedulingRequest[]

  @@unique([requisitionId, orderIndex])
  @@index([requisitionId])
}

/// Where an application came from. Kept as a table rather than an enum so an
/// organization can add boards without a migration, and so source
/// effectiveness reporting has a stable key to group by.
model SourceChannel {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  /// CAREERS_SITE, JOB_BOARD, REFERRAL, AGENCY, DIRECT, IMPORT, OTHER
  category    String   @default("JOB_BOARD")
  active      Boolean  @default(true)
  /// SHA-256 of the inbound API token, when this channel POSTs applications.
  tokenHash   String?  @unique
  createdAt   DateTime @default(now())

  postings     JobPosting[]
  applications Application[]
  inbound      InboundApplication[]
}

enum PostingStatus {
  DRAFT
  PUBLISHED
  PAUSED
  EXPIRED
  REMOVED
}

/// A requisition published to one channel. Separate from the requisition so
/// the same role can run on several boards with different lifecycles, and so
/// per-board performance is measurable.
model JobPosting {
  id            String        @id @default(cuid())
  requisitionId String
  requisition   Requisition   @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  channelId     String
  channel       SourceChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  status        PostingStatus @default(DRAFT)
  /// The board's own identifier, when it gives us one.
  externalRef   String?
  externalUrl   String?
  publishedAt   DateTime?
  expiresAt     DateTime?
  removedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([requisitionId, channelId])
  @@index([status])
}

enum ApplicationStatus {
  ACTIVE
  HIRED
  REJECTED
  WITHDRAWN
  ON_HOLD
}

model Application {
  id            String            @id @default(cuid())
  /// Short human reference for support conversations. Not a secret.
  reference     String            @unique
  candidateId   String
  candidate     Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  requisitionId String
  requisition   Requisition       @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  stageId       String?
  stage         PipelineStage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)
  status        ApplicationStatus @default(ACTIVE)
  channelId     String?
  channel       SourceChannel?    @relation(fields: [channelId], references: [id], onDelete: SetNull)
  /// Free-form campaign attribution captured at apply time (utm_*, referrer).
  sourceDetail  Json?
  /// Set when a teammate referred this person.
  referredById  String?
  referredBy    User?             @relation("ApplicationReferredBy", fields: [referredById], references: [id], onDelete: SetNull)
  /// Populated by knockout evaluation of the screening answers.
  knockedOut    Boolean           @default(false)
  knockoutReason String?
  rejectionReasonId String?
  rejectionReason   RejectionReason? @relation(fields: [rejectionReasonId], references: [id], onDelete: SetNull)
  rejectionNote String?
  rejectedAt    DateTime?
  hiredAt       DateTime?
  withdrawnAt   DateTime?
  appliedAt     DateTime          @default(now())
  /// Denormalized for "stale application" views without a subquery per row.
  lastActivityAt DateTime         @default(now())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  screeningAnswers ScreeningAnswer[]
  stageEvents      ApplicationStageEvent[]
  interviews       Interview[]
  scorecards       Scorecard[]
  offers           Offer[]
  notes            ApplicationNote[]
  documents        CandidateDocument[]
  referenceChecks  ReferenceCheck[]
  reviewRounds     ReviewRound[]
  socialMediaCheck SocialMediaCheck?
  backgroundCheck  BackgroundCheck?
  hire             Hire?
  workSamples      WorkSampleAssignment[]
  schedulingRequests SchedulingRequest[]
  /// The assessment invitation issued for this application, if any.
  invitations      Invitation[]

  @@unique([candidateId, requisitionId])
  @@index([requisitionId, status])
  @@index([stageId])
  @@index([candidateId])
}

/// Every stage transition, kept forever. Time-in-stage and funnel conversion
/// are computed from these rows rather than from the application's current
/// state, so history survives later edits.
model ApplicationStageEvent {
  id            String        @id @default(cuid())
  applicationId String
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stageId       String?
  stage         PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  /// Snapshot: stages can be renamed or deleted, history cannot change.
  stageName     String
  stageKind     StageKind
  fromStageName String?
  actorId       String?
  actor         User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// "SYSTEM" when the move was automatic (knockout, assessment completion).
  actorLabel    String?
  note          String?
  occurredAt    DateTime      @default(now())

  @@index([applicationId, occurredAt])
  @@index([stageId])
}

model RejectionReason {
  id        String   @id @default(cuid())
  label     String   @unique
  /// Groups reasons for reporting: QUALIFICATIONS, EXPERIENCE, PROCESS,
  /// CANDIDATE_DRIVEN, COMPENSATION, OTHER.
  category  String   @default("OTHER")
  /// Whether a rejection for this reason should send the candidate an email.
  notifyCandidate Boolean @default(true)
  active    Boolean  @default(true)
  orderIndex Int     @default(0)

  applications Application[]
}

enum ScreeningQuestionKind {
  SHORT_TEXT
  LONG_TEXT
  YES_NO
  SINGLE_CHOICE
  MULTI_CHOICE
  NUMBER
  FILE
}

/// A question asked on the application form. Knockout rules are deliberately
/// simple and inspectable — a rule nobody can read is a rule nobody can
/// defend when a rejected applicant asks why.
model ScreeningQuestion {
  id            String                @id @default(cuid())
  requisitionId String
  requisition   Requisition           @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  prompt        String
  kind          ScreeningQuestionKind
  required      Boolean               @default(true)
  orderIndex    Int
  /// Choices for SINGLE_CHOICE / MULTI_CHOICE.
  choices       String[]              @default([])
  /// When set, an answer failing this rule marks the application knocked out
  /// for human review. It never auto-rejects anybody.
  knockout      Boolean               @default(false)
  /// "EQUALS" | "NOT_EQUALS" | "MIN" | "MAX" | "INCLUDES"
  knockoutOperator String?
  knockoutValue    String?
  helpText      String?
  createdAt     DateTime              @default(now())

  answers ScreeningAnswer[]

  @@unique([requisitionId, orderIndex])
}

model ScreeningAnswer {
  id            String            @id @default(cuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionId    String
  question      ScreeningQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /// Snapshot of the prompt so a later edit cannot rewrite history.
  promptSnapshot String
  valueText     String?
  valueNumber   Float?
  valueList     String[]          @default([])
  createdAt     DateTime          @default(now())

  @@unique([applicationId, questionId])
}

model ApplicationNote {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String?
  author        User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body          String
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

// ---------------------------------------------------------------------------
// Structured interviewing
// ---------------------------------------------------------------------------

/// A reusable interview plan. The point of a kit is that every candidate for
/// a role is asked the same things and rated on the same attributes, which is
/// what makes the ratings comparable and the process defensible.
model InterviewKit {
  id          String   @id @default(cuid())
  name        String
  description String?
  /// Minutes the interview is scheduled for.
  durationMinutes Int  @default(45)
  active      Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  competencies KitCompetency[]
  questions    KitQuestion[]
  stages       PipelineStage[]
  interviews   Interview[]
  schedulingRequests SchedulingRequest[]
  reviewRounds ReviewRound[]
}

model KitCompetency {
  id          String       @id @default(cuid())
  kitId       String
  kit         InterviewKit @relation(fields: [kitId], references: [id], onDelete: Cascade)
  name        String
  /// What a strong answer looks like, so ratings mean the same thing to
  /// different interviewers.
  definition  String?
  orderIndex  Int

  ratings ScorecardRating[]
  evidence InterviewEvidence[]

  @@unique([kitId, orderIndex])
}

model KitQuestion {
  id          String       @id @default(cuid())
  kitId       String
  kit         InterviewKit @relation(fields: [kitId], references: [id], onDelete: Cascade)
  question    String
  listenFor   String?
  orderIndex  Int

  @@unique([kitId, orderIndex])
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Interview {
  id            String          @id @default(cuid())
  applicationId String
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stageId       String?
  stage         PipelineStage?  @relation(fields: [stageId], references: [id], onDelete: SetNull)
  kitId         String?
  kit           InterviewKit?   @relation(fields: [kitId], references: [id], onDelete: SetNull)
  title         String
  status        InterviewStatus @default(SCHEDULED)
  scheduledAt   DateTime
  durationMinutes Int           @default(45)
  /// Video link, room name, or phone number — whatever the team uses.
  meetingDetail String?
  scheduledById String?
  scheduledBy   User?           @relation("InterviewScheduledBy", fields: [scheduledById], references: [id], onDelete: SetNull)
  cancelledReason String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  participants InterviewParticipant[]
  scorecards   Scorecard[]
  schedulingRequest SchedulingRequest?
  reminders    ScheduledReminder[]
  recording    InterviewRecording?
  recordingConsents InterviewRecordingConsent[]

  @@index([applicationId])
  @@index([scheduledAt])
}

model InterviewParticipant {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Whether this participant is expected to submit a scorecard.
  scorecardRequired Boolean @default(true)

  @@unique([interviewId, userId])
  @@index([userId])
}

/// Deliberately a four-point scale with no neutral option. A midpoint lets an
/// interviewer avoid committing, which is the single most common way
/// structured interviewing degrades into unstructured interviewing.
enum ScorecardRecommendation {
  STRONG_NO
  NO
  YES
  STRONG_YES
}

enum ScorecardStatus {
  DRAFT
  SUBMITTED
}

model Scorecard {
  id            String                   @id @default(cuid())
  applicationId String
  application   Application              @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewId   String?
  interview     Interview?               @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  authorId      String
  author        User                     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  status        ScorecardStatus          @default(DRAFT)
  recommendation ScorecardRecommendation?
  /// Evidence for the recommendation. Required on submit.
  summary       String?
  submittedAt   DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  ratings ScorecardRating[]

  @@unique([interviewId, authorId])
  @@index([applicationId])
}

model ScorecardRating {
  id           String        @id @default(cuid())
  scorecardId  String
  scorecard    Scorecard     @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  competencyId String?
  competency   KitCompetency? @relation(fields: [competencyId], references: [id], onDelete: SetNull)
  /// Snapshot so a kit edit cannot rewrite a submitted scorecard.
  competencyName String
  /// 1-4, matching the recommendation scale. Null means "did not assess".
  rating       Int?
  note         String?

  @@unique([scorecardId, competencyName])
}

enum ReferenceCheckStatus {
  REQUESTED
  COMPLETED
  DECLINED
  UNREACHABLE
}

model ReferenceCheck {
  id            String               @id @default(cuid())
  applicationId String
  application   Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  refereeName   String
  refereeTitle  String?
  refereeCompany String?
  refereeEmail  String?
  refereePhone  String?
  relationship  String?
  status        ReferenceCheckStatus @default(REQUESTED)
  /// Structured notes from the call. Never a score.
  notes         String?
  conductedById String?
  conductedBy   User?                @relation(fields: [conductedById], references: [id], onDelete: SetNull)
  completedAt   DateTime?
  createdAt     DateTime             @default(now())

  @@index([applicationId])
}

// ---------------------------------------------------------------------------
// Offers
// ---------------------------------------------------------------------------

enum OfferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  DECLINED
  RESCINDED
  EXPIRED
}

model OfferLetterTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  /// Body with {{merge_fields}}. Authored by the organization and reviewed by
  /// their counsel — the platform supplies the mechanism, not the wording.
  body      String
  /// Text shown above the accept/decline buttons on the candidate page.
  acceptanceStatement String @default("By accepting below I confirm I have read this offer and accept the terms described in it.")
  active    Boolean  @default(true)
  createdById String?
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers Offer[]
}

model Offer {
  id            String      @id @default(cuid())
  reference     String      @unique
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requisitionId String
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  status        OfferStatus @default(DRAFT)
  jobTitle      String
  departmentName String?
  locationName  String?
  employmentType EmploymentType @default(FULL_TIME)
  workArrangement WorkArrangement @default(ONSITE)
  baseSalary    Int
  salaryCurrency String     @default("PHP")
  salaryPeriod  String      @default("MONTH")
  signingBonus  Int?
  variablePay   String?
  benefitsSummary String?
  startDate     DateTime?
  /// Deadline for the candidate to respond.
  expiresAt     DateTime?
  templateId    String?
  template      OfferLetterTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// The letter as rendered when it was sent. Frozen: what the candidate saw
  /// is what the record shows, whatever happens to the template afterwards.
  letterBody    String?
  letterPdfKey  String?
  /// SHA-256 of the candidate's acceptance token.
  acceptTokenHash String?   @unique
  sentAt        DateTime?
  respondedAt   DateTime?
  declineReason String?
  /// Typed name the candidate entered when accepting, with the metadata that
  /// makes the acceptance evidentiary.
  signatureName String?
  signatureIp   String?
  signatureUserAgent String?
  createdById   String?
  createdBy     User?       @relation("OfferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  approvals OfferApproval[]
  hire      Hire?

  @@index([applicationId])
  @@index([status])
}

model OfferApproval {
  id         String           @id @default(cuid())
  offerId    String
  offer      Offer            @relation(fields: [offerId], references: [id], onDelete: Cascade)
  stepIndex  Int
  approverId String
  approver   User             @relation("OfferApprover", fields: [approverId], references: [id], onDelete: Cascade)
  decision   ApprovalDecision @default(PENDING)
  comment    String?
  decidedAt  DateTime?
  createdAt  DateTime         @default(now())

  @@unique([offerId, stepIndex])
  @@index([approverId, decision])
}

// ---------------------------------------------------------------------------
// Ingestion and communications
// ---------------------------------------------------------------------------

enum InboundStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
  FAILED
  IGNORED
}

/// Raw inbound application payloads, kept before and after parsing.
///
/// Boards change their formats without warning and applicants only apply
/// once; when parsing fails the raw payload is the only way to recover the
/// application rather than lose a real person's candidacy.
model InboundApplication {
  id          String        @id @default(cuid())
  channelId   String?
  channel     SourceChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  /// "API" | "CSV" | "EMAIL" | "CAREERS_SITE"
  transport   String
  status      InboundStatus @default(RECEIVED)
  payload     Json
  /// Set once a candidate/application has been created from this payload.
  applicationId String?
  candidateId   String?
  error       String?
  receivedAt  DateTime      @default(now())
  processedAt DateTime?

  @@index([status])
  @@index([receivedAt])
}

/// Candidate-facing email copy, editable without a deploy. Rendered with the
/// same merge-field mechanism as offer letters.
model RecruitingEmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  subject   String
  body      String
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

/// Requisition-level activity feed, separate from the global audit log
/// because the hiring team reads this one.
model RequisitionEvent {
  id            String      @id @default(cuid())
  requisitionId String
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  type          String
  summary       String
  actorId       String?
  actor         User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  meta          Json?
  occurredAt    DateTime    @default(now())

  @@index([requisitionId, occurredAt])
}

// ===========================================================================
// INDEPENDENT TEAM REVIEW
//
// Distinct from interview scorecards: a review round asks named people to
// assess a candidate from the record — application, resume, assessment,
// interview write-ups — without having to be in an interview.
//
// The point is independence. Reviewers cannot see each other's reviews until
// they file their own, because a panel that reads the first opinion before
// forming its own is one opinion wearing four names.
// ===========================================================================

enum ReviewRoundStatus {
  OPEN
  CLOSED
}

model ReviewRound {
  id            String            @id @default(cuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requisitionId String
  requisition   Requisition       @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  name          String
  /// Criteria come from a kit so everyone rates the same things.
  kitId         String?
  kit           InterviewKit?     @relation(fields: [kitId], references: [id], onDelete: SetNull)
  /// When true, a reviewer sees nobody else's review until theirs is in.
  blind         Boolean           @default(true)
  status        ReviewRoundStatus @default(OPEN)
  dueAt         DateTime?
  requestedById String?
  requestedBy   User?             @relation("ReviewRoundRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  closedAt      DateTime?
  createdAt     DateTime          @default(now())

  reviews CandidateReview[]

  @@index([applicationId])
}

model CandidateReview {
  id             String                   @id @default(cuid())
  roundId        String
  round          ReviewRound              @relation(fields: [roundId], references: [id], onDelete: Cascade)
  reviewerId     String
  reviewer       User                     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  status         ScorecardStatus          @default(DRAFT)
  recommendation ScorecardRecommendation?
  summary        String?
  submittedAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  ratings CandidateReviewRating[]

  @@unique([roundId, reviewerId])
  @@index([reviewerId, status])
}

model CandidateReviewRating {
  id             String          @id @default(cuid())
  reviewId       String
  review         CandidateReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  /// Snapshot, so editing the kit cannot rewrite a filed review.
  criterionName  String
  rating         Int?
  note           String?

  @@unique([reviewId, criterionName])
}

// ===========================================================================
// SOCIAL MEDIA REVIEW
//
// Deliberately a structured human workflow, not an automated scanner.
//
// Screening someone's public social presence exposes the reviewer to age,
// religion, disability, pregnancy, national origin and political affiliation
// within seconds — none of which may inform a hiring decision, and all of
// which are unforgettable once seen. The controls that make this defensible
// are procedural: recorded consent, a reviewer who is not a decision-maker,
// findings recorded only against pre-agreed job-relevant categories, and the
// hiring team seeing the categorized outcome rather than the raw browsing.
// ===========================================================================

enum SocialCheckStatus {
  NOT_STARTED
  CONSENT_REQUESTED
  CONSENT_DECLINED
  AWAITING_REVIEW
  COMPLETED
  CANCELLED
}

enum SocialCheckOutcome {
  NOTHING_FOUND
  FINDINGS_TO_DISCUSS
}

/// Job-relevant conduct categories. Nothing here is a protected
/// characteristic, and that is the point: a finding must be about something
/// the person did that bears on the work.
enum SocialFindingCategory {
  VIOLENT_THREATS
  HARASSMENT_OR_ABUSE
  ILLEGAL_ACTIVITY
  CONFIDENTIALITY_BREACH
  MISREPRESENTATION
  SAFETY_RISK
}

model SocialMediaCheck {
  id            String             @id @default(cuid())
  applicationId String             @unique
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        SocialCheckStatus  @default(NOT_STARTED)
  /// SHA-256 of the candidate's disclosure link token.
  consentTokenHash String?         @unique
  consentRequestedAt DateTime?
  consentGivenAt   DateTime?
  consentDeclinedAt DateTime?
  /// Public profiles the candidate chose to disclose. Visible only to the
  /// assigned reviewer — a hiring manager who can open the links can see
  /// everything the process exists to keep out of the decision.
  disclosedProfiles Json?
  /// Recorded verbatim so consent is reconstructable years later.
  consentStatementVersion String?
  reviewerId    String?
  reviewer      User?              @relation("SocialCheckReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  outcome       SocialCheckOutcome?
  /// Reviewer's summary for the hiring team. Conduct only.
  reviewerNotes String?
  requestedById String?
  requestedBy   User?              @relation("SocialCheckRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  findings SocialMediaFinding[]
}

model SocialMediaFinding {
  id          String                @id @default(cuid())
  checkId     String
  check       SocialMediaCheck      @relation(fields: [checkId], references: [id], onDelete: Cascade)
  category    SocialFindingCategory
  /// What was observed, in conduct terms.
  description String
  /// Where it was seen. Reviewer-only, for the same reason as the profiles.
  sourceUrl   String?
  observedAt  DateTime?
  createdAt   DateTime              @default(now())

  @@index([checkId])
}

// ===========================================================================
// BACKGROUND CHECKS (Checkr)
//
// Consumer reports under the FCRA. Three things follow from that and are
// enforced rather than documented:
//
//  1. Disclosure and authorization happen before the report is ordered. The
//     Checkr invitation flow collects them, along with the SSN and date of
//     birth, so this platform never holds that data.
//  2. A report that returns "consider" is not a decision. Acting adversely on
//     it requires a pre-adverse notice with a copy of the report, a waiting
//     period for the candidate to dispute, and then a separate adverse action
//     notice.
//  3. Every step is timestamped, because the defence against an FCRA claim is
//     the record of having followed the sequence.
// ===========================================================================

enum BackgroundCheckStatus {
  NOT_STARTED
  INVITATION_SENT
  INVITATION_EXPIRED
  PENDING
  COMPLETE
  SUSPENDED
  CANCELLED
}

/// Checkr's report assessment. "CONSIDER" means a human must look, never that
/// the candidate failed.
enum BackgroundCheckResult {
  CLEAR
  CONSIDER
  DISPUTE
}

enum AdverseActionStage {
  NONE
  PRE_ADVERSE_SENT
  DISPUTED
  ADVERSE_ACTION_SENT
  CANCELLED
}

model BackgroundCheck {
  id            String                @id @default(cuid())
  applicationId String                @unique
  application   Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  offerId       String?
  status        BackgroundCheckStatus @default(NOT_STARTED)
  result        BackgroundCheckResult?
  /// Checkr package slug, e.g. "tasker_standard".
  packageSlug   String
  /// Work location sent to Checkr; drives which searches are permitted.
  workLocationCountry String            @default("US")
  workLocationState   String?
  workLocationCity    String?
  checkrCandidateId  String?
  checkrInvitationId String?
  checkrReportId     String?
  /// The candidate-facing Checkr link. Time limited by Checkr.
  invitationUrl String?
  invitedAt     DateTime?
  completedAt   DateTime?
  /// Per-screening statuses as Checkr reported them, for the audit record.
  reportSummary Json?
  adverseStage  AdverseActionStage    @default(NONE)
  preAdverseSentAt   DateTime?
  disputeReceivedAt  DateTime?
  adverseActionSentAt DateTime?
  adverseActionReason String?
  requestedById String?
  requestedBy   User?                 @relation("BackgroundCheckRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  events BackgroundCheckEvent[]

  @@index([status])
}

/// Every Checkr webhook and every action taken, kept raw.
model BackgroundCheckEvent {
  id        String          @id @default(cuid())
  checkId   String
  check     BackgroundCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)
  type      String
  summary   String?
  payload   Json?
  actorId   String?
  occurredAt DateTime       @default(now())

  @@index([checkId, occurredAt])
}

// ---------------------------------------------------------------------------
// Criterion validation: hires, post-hire performance, validity studies
//
// This is the part of the platform that lets the assessment stop making
// claims and start earning them. Nothing in here changes a candidate's
// score. It records what happened AFTER the hire, and asks whether the
// scores predicted it.
// ---------------------------------------------------------------------------

enum HireStatus {
  ACTIVE
  ON_LEAVE
  DEPARTED_VOLUNTARY
  DEPARTED_INVOLUNTARY
}

/// An employment record: the bridge between a candidate we assessed and an
/// employee whose performance we can observe. Created when an offer is
/// accepted, or entered by hand for hires that predate the platform.
model Hire {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// The assessment attempt supplying this hire's predictor scores. Frozen at
  /// creation: a study that silently swapped in a later attempt would be
  /// reporting on a different predictor than the one it names.
  attemptId   String?   @unique
  attempt     Attempt?  @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  applicationId String? @unique
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  offerId     String?   @unique
  offer       Offer?    @relation(fields: [offerId], references: [id], onDelete: SetNull)
  jobProfileId String?
  jobProfile  JobProfile? @relation(fields: [jobProfileId], references: [id], onDelete: SetNull)
  requisitionId String?
  requisition Requisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  jobTitle    String
  departmentId String?
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  locationId  String?
  location    Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  /// Who rates this person. Reviews are requested from them by cycle.
  managerId   String?
  manager     User?     @relation("HireManager", fields: [managerId], references: [id], onDelete: SetNull)
  hiredAt     DateTime
  status      HireStatus @default(ACTIVE)
  endedAt     DateTime?
  /// Free text. Never used as a criterion on its own — involuntary exit is
  /// recorded in `status`, and reasons vary too much to code automatically.
  endReason   String?
  createdById String?
  createdBy   User?     @relation("HireCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  reviews PerformanceReview[]
  metrics PerformanceMetric[]

  @@index([candidateId])
  @@index([jobProfileId])
  @@index([status])
  @@index([hiredAt])
}

enum PerformanceCycleKind {
  DAY_30
  DAY_90
  DAY_180
  ANNUAL
  AD_HOC
}

enum PerformanceCycleStatus {
  DRAFT
  OPEN
  CLOSED
}

/// A round of performance ratings. Either tenure-anchored (`dueAfterDays`,
/// e.g. every hire's 90-day review) or calendar-anchored (`opensAt`).
model PerformanceCycle {
  id           String @id @default(cuid())
  name         String
  kind         PerformanceCycleKind
  /// Days after the hire date at which this cycle falls due for a hire.
  /// Null for calendar cycles that fall due for everyone at once.
  dueAfterDays Int?
  opensAt      DateTime?
  closesAt     DateTime?
  status       PerformanceCycleStatus @default(DRAFT)
  /// Performance criterion keys rated in this cycle, in display order.
  /// Keys come from src/content/performance-criteria.ts.
  criterionKeys String[]
  instructions String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reviews PerformanceReview[]

  @@index([status])
}

enum PerformanceReviewStatus {
  DRAFT
  SUBMITTED
}

/// One rater's ratings of one hire in one cycle. Multiple raters per hire is
/// the point, not an edge case: two independent ratings are what make the
/// criterion's own reliability estimable.
model PerformanceReview {
  id       String @id @default(cuid())
  hireId   String
  hire     Hire   @relation(fields: [hireId], references: [id], onDelete: Cascade)
  cycleId  String
  cycle    PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  raterId  String
  rater    User   @relation("PerformanceRater", fields: [raterId], references: [id], onDelete: Cascade)
  status   PerformanceReviewStatus @default(DRAFT)
  /// Overall effectiveness, 1-5. Rated independently of the criterion rows so
  /// it is not a mechanical average of them.
  overallRating Int?
  /// Would you hire this person again, knowing what you know now?
  wouldRehire   Boolean?
  comment       String?
  submittedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ratings PerformanceRating[]

  @@unique([hireId, cycleId, raterId])
  @@index([raterId, status])
  @@index([cycleId, status])
}

model PerformanceRating {
  id           String @id @default(cuid())
  reviewId     String
  review       PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  criterionKey String
  /// 1-5 behaviourally anchored rating.
  value        Int
  note         String?

  @@unique([reviewId, criterionKey])
}

/// An objective post-hire outcome: quota attainment, output per week, error
/// rate. Kept apart from ratings because it does not share their rater bias
/// and does not share their scale.
model PerformanceMetric {
  id          String @id @default(cuid())
  hireId      String
  hire        Hire   @relation(fields: [hireId], references: [id], onDelete: Cascade)
  key         String
  label       String
  value       Float
  unit        String?
  /// True when a higher value is better. A study correlating against a
  /// lower-is-better metric flips the sign so "positive r" always means
  /// "the assessment predicted the good outcome".
  higherIsBetter Boolean @default(true)
  periodStart DateTime
  periodEnd   DateTime
  source      String?
  createdById String?
  createdBy   User?  @relation("MetricCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([hireId, key, periodStart, periodEnd])
  @@index([key])
}

enum ValidationCriterionKind {
  /// Mean of raters' overall effectiveness ratings.
  OVERALL_RATING
  /// Mean of one named performance criterion's ratings.
  COMPETENCY_RATING
  /// Mean across several named criteria (a composite criterion).
  COMPOSITE_RATING
  /// A named objective metric.
  METRIC
  /// Still employed at N days. A 0/1 criterion — point-biserial correlation.
  RETENTION
}

enum ValidationStudyStatus {
  DRAFT
  COMPUTED
  PUBLISHED
  ARCHIVED
}

/// A concurrent or predictive validity study: one criterion, one sample,
/// one set of coefficients, recomputable and dated.
model ValidationStudy {
  id            String @id @default(cuid())
  name          String
  description   String?
  jobProfileId  String?
  jobProfile    JobProfile? @relation(fields: [jobProfileId], references: [id], onDelete: SetNull)
  criterionKind ValidationCriterionKind
  /// Criterion key(s): a criterion key, several of them, or a metric key.
  criterionKeys String[]
  /// Days for a RETENTION criterion.
  retentionDays Int?
  /// Restrict to these cycle kinds; empty means every submitted review.
  cycleKinds    PerformanceCycleKind[]
  /// Hires made on or after this date only. Lets a study exclude a period
  /// before the current form version was in use.
  hiredFrom     DateTime?
  hiredTo       DateTime?
  /// Correct observed coefficients for range restriction using the applicant
  /// pool's own standard deviation, and for criterion unreliability using the
  /// interrater reliability measured in this sample. Both are reported
  /// alongside the observed value, never in place of it.
  correctRangeRestriction Boolean @default(true)
  correctAttenuation      Boolean @default(true)
  status        ValidationStudyStatus @default(DRAFT)
  /// Sample size, criterion reliability, gate verdicts, warnings.
  summary       Json?
  computedAt    DateTime?
  computedById  String?
  computedBy    User?  @relation("StudyComputedBy", fields: [computedById], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?  @relation("StudyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  coefficients ValidityCoefficient[]
  normTables   NormTable[]

  @@index([status])
  @@index([jobProfileId])
}

/// One predictor's relationship with the study's criterion.
model ValidityCoefficient {
  id        String @id @default(cuid())
  studyId   String
  study     ValidationStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)
  /// Exactly one of these identifies the predictor.
  construct    Construct?
  compositeKey String?
  label     String
  n         Int
  /// Observed Pearson r between predictor and criterion in this sample.
  r         Float
  ciLow     Float
  ciHigh    Float
  pValue    Float
  /// Benjamini-Hochberg adjusted p across the predictors in this study.
  qValue    Float
  /// Corrected for range restriction (Thorndike Case II), when computed.
  rRangeCorrected Float?
  /// Additionally corrected for criterion unreliability, when computed.
  rFullyCorrected Float?
  /// Predictor SD in the hired sample and in the applicant pool.
  sdRestricted   Float?
  sdUnrestricted Float?
  predictorMean  Float?
  /// INSUFFICIENT | PRELIMINARY | SUPPORTED — the honest sample-size verdict.
  verdict   String
  createdAt DateTime @default(now())

  @@unique([studyId, construct, compositeKey])
  @@index([studyId])
}

// ---------------------------------------------------------------------------
// Work samples
//
// A candidate does a piece of the actual job and someone grades it against a
// rubric written before anyone saw the work. Of everything in this platform
// this is the closest thing to watching someone do the job, which is why the
// grading controls matter more here than anywhere else: an unblinded,
// single-grader, rubric-free work sample is just an interview that takes
// longer.
// ---------------------------------------------------------------------------

enum WorkSampleStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum WorkSampleSubmissionKind {
  TEXT
  FILE
  TEXT_AND_FILE
}

/// The task definition. Original content authored by the organization.
model WorkSample {
  id           String @id @default(cuid())
  title        String
  /// Shown to the candidate before they start.
  summary      String?
  /// The task itself. Shown once the timer starts.
  instructions String
  /// What "good" looks like, in the candidate's own terms. Shown with the
  /// task: hiding the standard does not measure skill, it measures guessing.
  successCriteria String?
  submissionKind WorkSampleSubmissionKind @default(TEXT)
  /// Null means untimed. A timed sample runs on the server clock.
  timeLimitMinutes Int?
  /// Days the candidate has to start, from assignment.
  dueInDays    Int @default(5)
  /// Comma-free list of permitted file extensions, lower case, no dots.
  allowedFileTypes String[]
  status       WorkSampleStatus @default(DRAFT)
  /// Graders needed before a submission is considered graded. Two is the
  /// point of the exercise; one grader cannot be calibrated against anything.
  requiredGraders Int @default(2)
  jobProfileId String?
  jobProfile   JobProfile? @relation(fields: [jobProfileId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?  @relation("WorkSampleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  criteria    WorkSampleCriterion[]
  assignments WorkSampleAssignment[]

  @@index([status])
}

/// One row of the rubric. Levels are anchored in writing, because "4 out of 5"
/// means whatever the grader had in mind unless somebody wrote it down.
model WorkSampleCriterion {
  id           String @id @default(cuid())
  workSampleId String
  workSample   WorkSample @relation(fields: [workSampleId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  /// Anchors by level: [{ "level": 1, "text": "..." }, ...]. 1-4, no midpoint.
  anchors      Json
  /// Relative weight in the overall score. Equal weights are the default.
  weight       Float @default(1)
  orderIndex   Int   @default(0)

  ratings WorkSampleRating[]

  @@unique([workSampleId, name])
  @@index([workSampleId, orderIndex])
}

enum WorkSampleAssignmentStatus {
  ASSIGNED
  STARTED
  SUBMITTED
  EXPIRED
  WITHDRAWN
  GRADED
}

model WorkSampleAssignment {
  id           String @id @default(cuid())
  workSampleId String
  workSample   WorkSample @relation(fields: [workSampleId], references: [id], onDelete: Cascade)
  applicationId String
  application  Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// Shown to graders in place of the candidate's name.
  reference    String @unique
  /// SHA-256 of the candidate's access token.
  tokenHash    String @unique
  status       WorkSampleAssignmentStatus @default(ASSIGNED)
  assignedAt   DateTime @default(now())
  /// Deadline to START. Once started, the time limit governs.
  dueAt        DateTime
  startedAt    DateTime?
  /// Server-authoritative deadline, set when the candidate starts. The
  /// browser countdown is display only, exactly as in the assessment.
  expiresAt    DateTime?
  submittedAt  DateTime?
  /// Work in progress, saved as the candidate types.
  draftText    String?
  submittedText String?
  /// Uploaded file, when the sample asks for one.
  fileName     String?
  fileMimeType String?
  fileSizeBytes Int?
  objectKey    String?
  assignedById String?
  assignedBy   User?  @relation("WorkSampleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  grades WorkSampleGrade[]

  @@unique([workSampleId, applicationId])
  @@index([applicationId])
  @@index([status])
}

enum WorkSampleGradeStatus {
  DRAFT
  SUBMITTED
}

/// One grader's assessment of one submission.
model WorkSampleGrade {
  id           String @id @default(cuid())
  assignmentId String
  assignment   WorkSampleAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  graderId     String
  grader       User   @relation("WorkSampleGrader", fields: [graderId], references: [id], onDelete: Cascade)
  status       WorkSampleGradeStatus @default(DRAFT)
  /// Free-text evidence. Required on submit — a score with no reasoning
  /// cannot be reconciled with another grader's.
  comment      String?
  submittedAt  DateTime?
  /// True when this grade was revised after seeing another grader's, during
  /// reconciliation. Recorded so an independent grade is never confused with
  /// a reconciled one.
  reconciled   Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ratings WorkSampleRating[]

  @@unique([assignmentId, graderId])
  @@index([graderId, status])
}

model WorkSampleRating {
  id          String @id @default(cuid())
  gradeId     String
  grade       WorkSampleGrade @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  criterionId String
  criterion   WorkSampleCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  /// Snapshot, so editing the rubric cannot rewrite a submitted grade.
  criterionName String
  /// 1-4. Null means "could not assess from what was submitted".
  level       Int?
  note        String?

  @@unique([gradeId, criterionId])
}

// ---------------------------------------------------------------------------
// Talent CRM
//
// The people who nearly got the job are the best-qualified pool anyone has:
// already sourced, already assessed, already interviewed, and already
// interested. Losing them because the requisition closed is the most expensive
// ordinary mistake in recruiting.
//
// But a person who applied for one job did not thereby agree to sit in a
// marketing database indefinitely. Everything here is built around that:
// nobody enters a pool without being asked, nobody is contacted without
// agreeing, an opt-out is permanent, and membership expires on the
// organization's retention schedule rather than never.
// ---------------------------------------------------------------------------

enum TalentConsentStatus {
  /// We have not asked. Nobody may be contacted in this state.
  NOT_ASKED
  /// Asked; awaiting an answer. Still nobody may be contacted.
  INVITED
  OPTED_IN
  /// Permanent. Cannot be reversed by anyone inside the organization.
  OPTED_OUT
}

/// The CRM overlay on a candidate. Created when they are invited to a pool,
/// not when they apply — an application is not consent.
model TalentProfile {
  id          String    @id @default(cuid())
  candidateId String    @unique
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  consentStatus TalentConsentStatus @default(NOT_ASKED)
  consentAskedAt DateTime?
  consentAt   DateTime?
  /// How consent was obtained: "email_link", "verbal_recorded_by:<user>", etc.
  consentSource String?
  /// SHA-256 of the candidate's consent token, while the ask is outstanding.
  consentTokenHash String? @unique
  /// What the candidate said they are looking for, in their own words.
  interests   String?
  /// A recruiter's note. Never shown to the candidate.
  summary     String?
  /// When membership lapses under the retention policy. Null until consent.
  expiresAt   DateTime?
  lastContactedAt DateTime?
  contactCount Int      @default(0)
  createdById String?
  createdBy   User?     @relation("TalentProfileCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tags        TalentProfileTag[]
  memberships TalentPoolMember[]
  outreach    TalentOutreach[]

  @@index([consentStatus])
  @@index([expiresAt])
}

model TalentTag {
  id        String @id @default(cuid())
  label     String @unique
  /// SKILL | SENIORITY | LOCATION | LANGUAGE | OTHER. Free-form grouping.
  category  String @default("OTHER")
  createdAt DateTime @default(now())

  profiles TalentProfileTag[]

  @@index([category])
}

model TalentProfileTag {
  id        String @id @default(cuid())
  profileId String
  profile   TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tagId     String
  tag       TalentTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  addedById String?
  addedBy   User?  @relation("TalentTagAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([profileId, tagId])
  @@index([tagId])
}

model TalentPool {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  /// The kind of role this pool is for, when it is role-specific.
  jobProfileId String?
  jobProfile  JobProfile? @relation(fields: [jobProfileId], references: [id], onDelete: SetNull)
  active      Boolean @default(true)
  createdById String?
  createdBy   User?   @relation("TalentPoolCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members TalentPoolMember[]

  @@index([active])
}

model TalentPoolMember {
  id        String @id @default(cuid())
  poolId    String
  pool      TalentPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  profileId String
  profile   TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// Why this person is in this pool. Written by whoever added them.
  note      String?
  addedById String?
  addedBy   User?  @relation("TalentPoolMemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([poolId, profileId])
  @@index([profileId])
}

/// A recorded contact. Exists so two recruiters do not both reach out, and so
/// "how often has this person been approached" is answerable.
model TalentOutreach {
  id            String @id @default(cuid())
  profileId     String
  profile       TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  requisitionId String?
  requisition   Requisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  /// EMAIL | PHONE | MESSAGE | OTHER.
  channel       String @default("EMAIL")
  note          String?
  sentById      String?
  sentBy        User?  @relation("TalentOutreachSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  sentAt        DateTime @default(now())

  @@index([profileId, sentAt])
}

/// Permanent opt-out list, keyed by a hash of the email address.
///
/// Hashed on purpose. An opt-out has to outlive the deletion of the person's
/// record — otherwise purging their data under the retention policy would
/// erase the fact that they asked not to be contacted, and the next import
/// would add them straight back. Storing the hash lets a future address be
/// checked against the list without keeping the address itself.
model TalentSuppression {
  id        String @id @default(cuid())
  emailHash String @unique
  /// "opted_out" | "requested_deletion" | "manual".
  reason    String @default("opted_out")
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Scheduling
//
// The back-and-forth to book one interview costs more recruiter time than
// anything else in the pipeline, and every day of it is a day a candidate
// spends talking to someone else.
//
// Every instant stored here is UTC. Availability is written in a person's own
// zone and converted; a panel spread across zones is the normal case, not an
// edge case, and "9 to 5" means nothing without knowing whose 9.
// ---------------------------------------------------------------------------

/// A recurring weekly window when someone is willing to interview, expressed
/// in minutes from midnight in that user's own time zone.
model AvailabilityRule {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 0 = Sunday.
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  active      Boolean @default(true)
  createdAt   DateTime @default(now())

  @@index([userId, dayOfWeek])
}

/// A one-off change: a day off, or an extra window opened for a specific date.
model AvailabilityException {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The calendar date in the user's own zone, stored as midnight UTC.
  date        DateTime
  startMinute Int
  endMinute   Int
  /// False blocks the window; true opens one outside the weekly pattern.
  available   Boolean @default(false)
  reason      String?
  createdAt   DateTime @default(now())

  @@index([userId, date])
}

enum SchedulingRequestStatus {
  OPEN
  BOOKED
  CANCELLED
  EXPIRED
}

/// An invitation to a candidate to pick a time.
model SchedulingRequest {
  id            String @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kitId         String?
  kit           InterviewKit? @relation(fields: [kitId], references: [id], onDelete: SetNull)
  stageId       String?
  stage         PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  title         String
  durationMinutes Int @default(45)
  /// Shown to the candidate: what to expect, what to bring.
  notes         String?
  /// Where the interview happens. Copied onto the interview when booked.
  meetingDetail String?
  status        SchedulingRequestStatus @default(OPEN)
  reference     String @unique
  /// SHA-256 of the candidate's booking token.
  tokenHash     String @unique
  /// The window inside which slots may be offered.
  earliestAt    DateTime
  latestAt      DateTime
  /// Hours of notice a candidate must give. Stops a 6am booking for 7am.
  minNoticeHours Int @default(12)
  /// The candidate's own zone, once we know it. Used for reminders.
  candidateTimeZone String?
  interviewId   String? @unique
  interview     Interview? @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  rescheduleCount Int @default(0)
  maxReschedules Int @default(2)
  cancelledReason String?
  createdById   String?
  createdBy     User?  @relation("SchedulingRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  panelists SchedulingPanelist[]

  @@index([applicationId])
  @@index([status])
}

model SchedulingPanelist {
  id        String @id @default(cuid())
  requestId String
  request   SchedulingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Required panelists must all be free for a slot to be offered. Optional
  /// ones are invited to whatever the candidate picks.
  required  Boolean @default(true)

  @@unique([requestId, userId])
  @@index([userId])
}

enum ReminderKind {
  CANDIDATE_DAY_BEFORE
  CANDIDATE_HOUR_BEFORE
  PANELIST_DAY_BEFORE
}

/// A reminder due to be sent. Written when an interview is booked and marked
/// sent when it goes out, so a retry cannot send it twice.
model ScheduledReminder {
  id          String @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  kind        ReminderKind
  /// Who it goes to. Null recipient means the candidate.
  userId      String?
  user        User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  dueAt       DateTime
  sentAt      DateTime?
  /// Set when the interview moved or was cancelled before this went out.
  cancelledAt DateTime?
  createdAt   DateTime @default(now())

  @@unique([interviewId, kind, userId])
  @@index([dueAt, sentAt])
}

// ---------------------------------------------------------------------------
// Interview intelligence
//
// A recorded interview, transcribed, with the AI pulling out what the
// candidate ACTUALLY SAID against each competency the kit asks about — so the
// interviewer rates from evidence rather than from memory of an impression.
//
// Two hard constraints run through every model here.
//
// ALL-PARTY CONSENT. Not "two-party": every person in the room. The
// Philippines' Anti-Wiretapping Act (RA 4200) makes recording a private
// communication without the consent of all parties a criminal offence, and
// several US states require all-party consent too. There is no one-party
// mode in this schema because there is no lawful one for this organization.
//
// THE AI NEVER RATES. It extracts quotes and maps them to competencies. The
// evidence model has no rating, no score and no recommendation field — the
// guarantee is structural, not a matter of prompt wording. An interviewer
// reads the quotes and forms their own view, in the scorecard, as before.
//
// What is deliberately absent: any analysis of voice, tone, pace, sentiment,
// emotion, confidence or engagement, and any analysis of video at all. Those
// are inferences about a person from how they sound and look rather than from
// what they said, and this platform does not make them anywhere.
// ---------------------------------------------------------------------------

enum RecordingConsentStatus {
  PENDING
  GRANTED
  DECLINED
  WITHDRAWN
}

enum RecordingConsentParty {
  CANDIDATE
  INTERVIEWER
}

/// One person's answer about being recorded. Every party needs a GRANTED row
/// before recording may begin, and any WITHDRAWN row ends it.
model InterviewRecordingConsent {
  id          String @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  party       RecordingConsentParty
  /// Set for interviewers. Null means the candidate.
  userId      String?
  user        User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The user id, or the literal "CANDIDATE". Exists because a unique index
  /// over a nullable column does not constrain anything in Postgres — NULL is
  /// never equal to NULL, so two candidate rows for one interview would both
  /// be accepted, and "did the candidate agree?" would have two answers.
  partyKey    String
  status      RecordingConsentStatus @default(PENDING)
  /// SHA-256 of the candidate's consent link token, while outstanding.
  tokenHash   String? @unique
  /// The exact wording shown, kept so what someone agreed to is reconstructable.
  statementVersion String
  decidedAt   DateTime?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([interviewId, partyKey])
  @@index([interviewId, status])
}

enum InterviewRecordingStatus {
  AWAITING_CONSENT
  READY
  UPLOADED
  TRANSCRIBED
  ANALYZED
  DELETED
}

model InterviewRecording {
  id          String @id @default(cuid())
  interviewId String @unique
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  status      InterviewRecordingStatus @default(AWAITING_CONSENT)
  /// Audio only. Video adds nothing this platform is willing to analyze and
  /// multiplies what a breach would expose.
  fileName    String?
  mimeType    String?
  sizeBytes   Int?
  objectKey   String?
  durationSeconds Int?
  /// How the transcript arrived: "uploaded_vtt", "uploaded_srt", "pasted".
  transcriptSource String?
  uploadedById String?
  uploadedBy  User?  @relation("RecordingUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt  DateTime?
  transcribedAt DateTime?
  analyzedAt  DateTime?
  /// Set when the media is purged but the transcript is kept, or vice versa.
  mediaDeletedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  segments TranscriptSegment[]
  evidence InterviewEvidence[]
}

model TranscriptSegment {
  id          String @id @default(cuid())
  recordingId String
  recording   InterviewRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  orderIndex  Int
  /// Whatever the transcript called them. Not resolved to a person: guessing
  /// who "Speaker 2" is would put words in someone's mouth.
  speakerLabel String?
  startMs     Int
  endMs       Int
  text        String

  @@unique([recordingId, orderIndex])
  @@index([recordingId, startMs])
}

/// A quote from the transcript, against a competency the kit asks about.
///
/// Note what this model does not have: a rating, a score, a level, a verdict,
/// a sentiment, or a recommendation. There is nowhere to put one.
model InterviewEvidence {
  id          String @id @default(cuid())
  recordingId String
  recording   InterviewRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  competencyId String?
  competency  KitCompetency? @relation(fields: [competencyId], references: [id], onDelete: SetNull)
  /// Snapshot, so editing the kit cannot rewrite what was found.
  competencyName String
  /// Verbatim from the transcript. Never paraphrased: a paraphrase is the
  /// model's words presented as the candidate's.
  quote       String
  startMs     Int
  endMs       Int
  /// One neutral sentence on why this passage is relevant to the competency.
  /// Explicitly not an evaluation of what was said.
  relevance   String
  /// Set when a human marked this quote as mis-attributed or out of context.
  dismissedById String?
  dismissedBy User?  @relation("EvidenceDismissedBy", fields: [dismissedById], references: [id], onDelete: SetNull)
  dismissedAt DateTime?
  dismissedReason String?
  promptVersion String
  createdAt   DateTime @default(now())

  @@index([recordingId, competencyName])
}
