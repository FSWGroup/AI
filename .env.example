# =============================================================================
# FSW Academy — environment configuration
#
# Copy to .env and fill in. Every variable is documented below.
#
# Only DATABASE_URL, AUTH_SECRET, and FIELD_ENCRYPTION_KEY are REQUIRED.
# Everything else is optional: a missing provider disables only its own
# capability. The application never crashes because an integration is
# unconfigured — see Admin → Integrations for live status.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED — Database
# -----------------------------------------------------------------------------

# PostgreSQL connection string. Requires the pgvector, pg_trgm, and unaccent
# extensions; migrations create them.
DATABASE_URL="postgresql://user:password@localhost:5432/fsw_academy?schema=public"

# Separate database used by `prisma migrate dev` to detect schema drift.
# Only needed in development. Never point this at production.
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/fsw_academy_shadow?schema=public"

# Dedicated database for integration tests. The name must contain "test".
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/fsw_academy_test?schema=public"


# -----------------------------------------------------------------------------
# REQUIRED — Secrets
# -----------------------------------------------------------------------------

# Signs session cookies and tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Encrypts sensitive profile fields and integration configs (AES-256-GCM).
# MUST decode to exactly 32 bytes. Generate with: openssl rand -base64 32
#
# WARNING: if this key is lost, encrypted sensitive fields cannot be recovered.
# Store it in a secrets manager and back it up separately from the database.
# Rotating it requires re-encrypting existing values.
FIELD_ENCRYPTION_KEY=""


# -----------------------------------------------------------------------------
# REQUIRED IN PRODUCTION — URLs
# -----------------------------------------------------------------------------

# Public base URL of the application. Used in emails, certificates, and
# OAuth callbacks. No trailing slash.
APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Session lifetime in seconds. Default 12 hours.
SESSION_MAX_AGE_SECONDS="43200"


# -----------------------------------------------------------------------------
# Authentication providers
# -----------------------------------------------------------------------------

# Email + password sign-in. Set to "false" to require SSO or magic link only.
AUTH_ENABLE_PASSWORD="true"

# --- Microsoft Entra ID (Azure AD) single sign-on ---
# Enables "Continue with Microsoft". MFA is enforced by your Entra ID policies.
# Register an app in Entra ID, add the redirect URI:
#   {APP_URL}/api/auth/callback/microsoft-entra-id
# All three must be set for SSO to appear.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# For a single tenant: https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""


# -----------------------------------------------------------------------------
# Email delivery
#
# Two options. Resend takes precedence when both are set.
# Without either, notifications stay in-app only and magic-link sign-in is off.
# -----------------------------------------------------------------------------

# --- Option A: Resend (recommended) ---
RESEND_API_KEY=""

# --- Option B: SMTP ---
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_SERVER_SECURE="false"

# Required by both options. Must be a verified sender.
EMAIL_FROM="FSW Academy <academy@fswelsford.com>"


# -----------------------------------------------------------------------------
# AI providers
#
# Text generation powers Ask FSW AI, the Training Coach, AI drafting of SOPs
# and courses, quiz generation, translation, and quality checks.
# Anthropic is preferred for text; OpenAI additionally provides embeddings,
# text-to-speech, and image generation.
# -----------------------------------------------------------------------------

# --- Anthropic (preferred for text) ---
ANTHROPIC_API_KEY=""
# Model id. claude-sonnet-5 balances quality and cost for answers and
# drafting; claude-opus-5 is stronger, and claude-haiku-4-5-20251001 cheaper.
ANTHROPIC_MODEL="claude-sonnet-5"

# --- OpenAI (text fallback; embeddings, TTS, and images) ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
# Semantic search for Ask FSW AI. Without it, retrieval falls back to keyword
# search — which still enforces the same permission filtering.
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_TTS_MODEL="tts-1"
OPENAI_IMAGE_MODEL="gpt-image-1"
# Override for Azure OpenAI or a self-hosted OpenAI-compatible gateway.
OPENAI_BASE_URL=""

# --- Optional alternative embedding provider ---
VOYAGE_API_KEY=""

# --- Optional alternative text-to-speech provider ---
ELEVENLABS_API_KEY=""


# -----------------------------------------------------------------------------
# AI video — avatar presenters (optional)
#
# Without either key, the AI Avatar Presenter mode is unavailable. All other
# video modes render locally with FSW branding via ffmpeg.
# -----------------------------------------------------------------------------

HEYGEN_API_KEY=""
SYNTHESIA_API_KEY=""


# -----------------------------------------------------------------------------
# Video rendering
# -----------------------------------------------------------------------------

# Path to the ffmpeg binary. Defaults to "ffmpeg" on PATH.
# Required for the local branded video renderer to output MP4 files.
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"


# -----------------------------------------------------------------------------
# Storage
#
# "local" writes to the filesystem — correct for development, NOT for
# multi-instance production (each instance would have its own disk).
# "s3" uses any S3-compatible service: AWS S3, Cloudflare R2, MinIO, or
# Supabase Storage's S3 endpoint.
# -----------------------------------------------------------------------------

STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"

S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Set for non-AWS S3-compatible services, e.g.
# https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=""

# Maximum upload size in megabytes.
MAX_UPLOAD_MB="200"


# -----------------------------------------------------------------------------
# Notification mirrors (optional)
# -----------------------------------------------------------------------------

SLACK_WEBHOOK_URL=""
TEAMS_WEBHOOK_URL=""


# -----------------------------------------------------------------------------
# Observability (optional)
# -----------------------------------------------------------------------------

# debug | info | warn | error
LOG_LEVEL="info"

# Error monitoring. Training content and personal data are never sent.
SENTRY_DSN=""


# -----------------------------------------------------------------------------
# Build target
# -----------------------------------------------------------------------------

# Set to "true" only when building a container image. It makes Next.js emit a
# self-contained server under .next/standalone, which is what the Dockerfile
# runs. Leave it unset for Vercel and for local production serving, because
# standalone output is incompatible with `next start`.
BUILD_STANDALONE=""


# -----------------------------------------------------------------------------
# Background worker
# -----------------------------------------------------------------------------

# Milliseconds between queue polls when idle.
WORKER_POLL_MS="2000"


# -----------------------------------------------------------------------------
# Development seeding
# -----------------------------------------------------------------------------

# Password assigned to every seeded demonstration account.
# NEVER set this in production, and never seed a production database.
SEED_PASSWORD="FswAcademy!2026"
