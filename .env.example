# FSW Layer 0 — environment template.
# Names and placeholders only. Never commit real values (spec §62).

NODE_ENV=development
LOG_LEVEL=debug
PORT=3000

# --- Database (ADR-0002) -----------------------------------------------------
# Application role: DML only. No DDL. No UPDATE/DELETE on audit.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/fsw_layer0
# Migration role: DDL. Used only by the migration job.
DATABASE_MIGRATION_URL=postgres://USER:PASSWORD@localhost:5432/fsw_layer0
# Read-only role for reporting/BI (ADR-0031). Points at the replica in production.
DATABASE_READONLY_URL=
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- Object storage (ADR-0026) ----------------------------------------------
# 'filesystem' for local development and tests; 's3' elsewhere.
OBJECT_STORE_DRIVER=filesystem
OBJECT_STORE_ROOT=./var/objects
OBJECT_STORE_BUCKET=
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_REGION=
OBJECT_STORE_ACCESS_KEY_ID=
OBJECT_STORE_SECRET_ACCESS_KEY=

# --- Authentication (ADR-0020) ----------------------------------------------
# Issuers are registered as rows in iam.issuer, not here. This only enables
# the development bypass, which must never be true outside local/test.
AUTH_DEV_BYPASS=false
AUTH_JWKS_CACHE_TTL_SECONDS=3600

# --- Credential hashing (ADR-0020) ------------------------------------------
# Server-side pepper for API credential hashes. 32+ random bytes, base64.
CREDENTIAL_PEPPER=

# --- Raw payload encryption (ADR-0027) --------------------------------------
# Master key wrapping per-subject data keys. 32 random bytes, base64.
PII_MASTER_KEY=

# --- Webhook dispatch (ADR-0010) --------------------------------------------
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_TIMEOUT_MS=10000

# --- Telemetry (ADR-0032) ---------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=fsw-layer0

# --- Connectors -------------------------------------------------------------
# Prophet 21 (ADR-0023): where approved export files land. No P21 credentials
# exist and none are expected; the connector reads files, not an API.
P21_LANDING_PATH=./var/landing/p21
P21_SOURCE_TIMEZONE=America/New_York
P21_FILE_ENCODING=windows-1252

# Pipedrive (ADR-0024). Leave blank; tests never contact Pipedrive.
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=
PIPEDRIVE_WEBHOOK_SECRET=
