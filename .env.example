# ============================================================================
# FSW People — environment variables
# Copy to .env and fill in values. The app validates these at startup
# (src/lib/env.ts) and fails fast with a clear message if a REQUIRED value
# is missing or malformed. OPTIONAL integrations degrade gracefully.
# ============================================================================

# ---------------------------------------------------------------------------
# REQUIRED — core infrastructure
# ---------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fsw_people?schema=public"

# Secret used to sign/derive session tokens. Generate: openssl rand -hex 32
SESSION_SECRET=""

# 32-byte hex key for AES-256-GCM field-level encryption (SSN, bank accounts,
# tax IDs, passports, Philippine government identifiers).
# Generate: openssl rand -hex 32
# ROTATION: see SECURITY.md — values are versioned (enc:v1:...) to allow
# key rotation without a big-bang re-encryption.
FIELD_ENCRYPTION_KEY=""

# HMAC key for expiring signed document URLs. Generate: openssl rand -hex 32
DOCUMENT_URL_SIGNING_KEY=""

# Public base URL of the deployment (used in emails and signed links)
APP_BASE_URL="https://people.fswelsford.com"

# ---------------------------------------------------------------------------
# REQUIRED — document storage
# ---------------------------------------------------------------------------

# "local" for single-node/dev, "s3" for production object storage
STORAGE_DRIVER="local"

# When STORAGE_DRIVER=local
STORAGE_LOCAL_DIR="./.storage"

# When STORAGE_DRIVER=s3 (any S3-compatible store: AWS S3, Cloudflare R2, ...)
# The bucket MUST be private. FSW People only ever hands out short-lived
# signed URLs through its own authenticated endpoint.
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---------------------------------------------------------------------------
# OPTIONAL — email delivery
# ---------------------------------------------------------------------------

# "outbox" (dev: messages are stored in the DB and viewable at
# Admin → Email Outbox) or "smtp"
EMAIL_DRIVER="outbox"
EMAIL_FROM="FSW People <people@fswelsford.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ---------------------------------------------------------------------------
# OPTIONAL — AI assistant (disabled when unset)
# ---------------------------------------------------------------------------
# Provider abstraction lives in src/lib/ai/. The assistant always runs under
# the requesting user's permissions; see SECURITY.md.
AI_PROVIDER=""            # e.g. "anthropic"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5"  # model used for advisory AI help (interview questions)

# ---------------------------------------------------------------------------
# OPTIONAL — Indeed job posting and Indeed Apply (disabled when unset)
# ---------------------------------------------------------------------------
# INDEED_FEED_TOKEN protects the XML job feed Indeed crawls. It is the only
# thing between the public internet and every published job, so generate it
# with `openssl rand -hex 32` and treat the resulting feed URL as a secret.
# Without it, /api/indeed/feed returns 404 and the publish controls stay off.
INDEED_FEED_TOKEN=""

# INDEED_APPLY_SECRET verifies the HMAC signature on inbound Indeed Apply
# deliveries. Without it, /api/indeed/apply returns 404 and applicants apply
# on the public /careers pages instead. `openssl rand -hex 32`.
INDEED_APPLY_SECRET=""

# Publisher API token Indeed issues when Indeed Apply is enabled on your
# account. Only when BOTH this and INDEED_APPLY_SECRET are set does the feed
# advertise apply-inside-Indeed — a half-configured Apply button would fail.
INDEED_APPLY_API_TOKEN=""

# Employer name shown on the feed and the public careers pages.
INDEED_COMPANY_NAME="FSW Group"

# ---------------------------------------------------------------------------
# OPTIONAL — future integrations (Integration Center adapters)
# ---------------------------------------------------------------------------
# Microsoft Entra ID SSO / Microsoft 365
MS_ENTRA_TENANT_ID=""
MS_ENTRA_CLIENT_ID=""
MS_ENTRA_CLIENT_SECRET=""

# Payroll provider (Gusto / ADP / Paychex / QuickBooks Payroll adapter)
PAYROLL_PROVIDER=""
PAYROLL_API_KEY=""

# Background checks
BACKGROUND_CHECK_PROVIDER=""
BACKGROUND_CHECK_API_KEY=""

# External e-signature (DocuSign / Adobe Sign) for documents with statutory
# e-sign requirements beyond internal acknowledgment
ESIGN_PROVIDER=""
ESIGN_API_KEY=""

# ---------------------------------------------------------------------------
# OPTIONAL — Certified e-signature (SignNow)
# ---------------------------------------------------------------------------
# Without these, documents still support the internal acknowledgment flow
# (typed name + IP + timestamp) and the UI says the certified option is off.
#
# POINT AT THE EVALUATION HOST WHILE TESTING. A sandbox key against the
# production host sends real invites to real people.
ESIGN_PROVIDER="signnow"
SIGNNOW_API_BASE="https://api-eval.signnow.com"
SIGNNOW_CLIENT_ID=""
SIGNNOW_CLIENT_SECRET=""
SIGNNOW_USERNAME=""
SIGNNOW_PASSWORD=""
# Verifies the HMAC on inbound webhooks. openssl rand -hex 32.
# Without it the webhook endpoint returns 404 rather than trusting callers.
SIGNNOW_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# OPTIONAL — SharePoint document storage (STORAGE_DRIVER=graph)
# ---------------------------------------------------------------------------
# The site MUST be granted to this app registration with Sites.Selected and
# have NO human members. SharePoint permissions are a separate system from
# FSW People's RBAC — if people can browse the library, the document
# authorization rules and the download audit trail stop being the real
# control. Never point this at a Team's document library.
MS_GRAPH_TENANT_ID=""
MS_GRAPH_CLIENT_ID=""
MS_GRAPH_CLIENT_SECRET=""
MS_GRAPH_SITE_ID=""
MS_GRAPH_ROOT_FOLDER="FSW People"

# ---------------------------------------------------------------------------
# NOTE — after upgrading
# ---------------------------------------------------------------------------
# Adding a permission to the catalog changes code, not the RolePermission rows
# an existing database already holds. Run `npx tsx scripts/sync-roles.ts` after
# every deploy so new permissions reach the roles that should have them. It is
# additive and never removes a grant an administrator has tailored.
