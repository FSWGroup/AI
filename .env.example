# --- Database ---
DATABASE_URL="postgresql://fsw:fsw_dev_password@localhost:5432/fsw_workfit"

# --- Application ---
# Base URL used in invitation emails and signed links.
APP_BASE_URL="http://localhost:3000"
# 64+ hex chars. Used to sign session cookies, resume tokens, and playback URLs.
# Generate with: openssl rand -hex 32
APP_SECRET="change-me-generate-a-real-secret"
# "development" | "production". Production refuses webcam invitations until
# privacy notice, retention, object storage, and HTTPS are configured.
NODE_ENV="development"

# --- Object storage for webcam recordings ---
# "local" stores chunks under .storage/ (development only).
# "s3" uses S3/R2-compatible presigned multipart uploads.
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="fsw-workfit-recordings"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Email ---
# "console" logs email to the dev outbox table (development).
# "smtp" and "resend" are wired through the same abstraction.
EMAIL_PROVIDER="console"
EMAIL_FROM="assessments@fswgroup.example"

# --- AI decision support (optional) ---
# Enables the résumé/assessment interview brief and job-description benchmark
# proposals. Without it those two features show a "not configured" notice and
# everything else works unchanged. See docs/AI-FEATURES.md.
ANTHROPIC_API_KEY=""

# --- PDF rendering ---
# Path to a Chromium executable for server-side PDF generation.
CHROMIUM_PATH="/opt/pw-browsers/chromium"
