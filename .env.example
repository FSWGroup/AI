# Welsford Product Intelligence — local development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wpi
# Optional. When unset, the LLM layer runs in "null" mode: deterministic parsing only, no generation.
ANTHROPIC_API_KEY=
WPI_LLM_MODEL=claude-opus-5-5
# Shopify (leave blank to use fixtures). Fixture mode is the default and is labeled everywhere.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-07
# Prophet 21 (leave blank to use fixtures)
P21_BASE_URL=
P21_API_TOKEN=
