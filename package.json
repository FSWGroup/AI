{
  "name": "fsw-layer0",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "tsx tools/migrate.ts up",
    "db:status": "tsx tools/migrate.ts status",
    "db:verify": "tsx tools/migrate.ts verify",
    "db:reset": "tsx tools/migrate.ts reset",
    "db:codegen": "kysely-codegen --out-file src/platform/db/schema.d.ts --camel-case false --dialect postgres",
    "metadata:apply": "tsx tools/metadata.ts apply",
    "metadata:check": "tsx tools/metadata.ts check",
    "events:catalog": "tsx tools/event-catalog.ts",
    "test": "vitest run --exclude '**/*.perf.ts'",
    "test:watch": "vitest",
    "test:perf": "vitest run tests/perf",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.8.1",
    "@sinclair/typebox": "0.34.52",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "decimal.js": "10.6.0",
    "fastify": "5.12.1",
    "kysely": "0.29.5",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "eslint": "10.9.1",
    "fast-check": "4.9.0",
    "kysely-codegen": "0.20.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
